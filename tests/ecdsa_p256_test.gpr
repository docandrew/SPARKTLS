with "../sparktls.gpr";

project ECDSA_P256_Test is

   for Create_Missing_Dirs use "True";
   for Object_Dir use "../obj/tests";
   for Source_Dirs use (".");
   for Main use ("ecdsa_p256_test.adb", "ecdsa_p384_test.adb", "ecdsa_bench.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-gnatQ", "-gnatw.X", "-gnata");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end ECDSA_P256_Test;
