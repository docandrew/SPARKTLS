   procedure Case_Self_Signed (Name : String; DER : Byte_Seq) is
      Cert : X509.Certificate;
      OK   : Boolean;
   begin
      X509.Parse (X509.Byte_Seq (DER), Cert, OK);
      Check (Name & ": parses", OK);
      if OK then
         Check (Name & ": self-signature verifies",
                SPARKTLS.Cert_Verify.Verify_Cert_Signature (DER, Cert, Cert));
         declare
            Bad      : Byte_Seq := DER;
            Bad_Cert : X509.Certificate;
            Bad_OK   : Boolean;
         begin
            --  The signature value is the tail of the certificate; flip a
            --  byte near the end and re-parse (the parser captures the
            --  signature spans, so the tampered DER must be what is parsed).
            Bad (Bad'Last - 4) := Bad (Bad'Last - 4) xor 16#01#;
            X509.Parse (X509.Byte_Seq (Bad), Bad_Cert, Bad_OK);
            Check (Name & ": tampered signature rejected",
                   Bad_OK
                   and then not SPARKTLS.Cert_Verify.Verify_Cert_Signature (Bad, Bad_Cert, Cert));
         end;
      end if;
   end Case_Self_Signed;
begin
   Put_Line ("--- SPARKTLS.Cert_Verify.Verify_Cert_Signature: hash/curve combinations ---");
   Case_Self_Signed ("P-384 key, ecdsa-with-SHA256", P384_SHA256_DER);
   Case_Self_Signed ("P-256 key, ecdsa-with-SHA384", P256_SHA384_DER);
   New_Line;
   Put_Line ("=== Results: " & Pass'Image & "/" & Total'Image
             & " passed, " & Fail'Image & " failed ===");
   if Fail > 0 then
      Ada.Command_Line.Set_Exit_Status (1);
   end if;
end Test_Cert_Sig_Algos;
