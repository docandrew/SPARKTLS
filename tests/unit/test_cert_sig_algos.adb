--  Certificate-signature algorithm/curve combinations. A self-signed
--  P-384 certificate signed ecdsa-with-SHA256 exercises the digest
--  placement for a hash shorter than the group order (FIPS 186-4 6.4:
--  the leftmost min (hashlen, qlen) bits form the integer, so the 32-byte
--  digest is right-aligned in the 48-byte scalar). Before 2026-09 it was
--  left-aligned (e * 2^128) and every such signature failed. The P-256
--  certificate signed ecdsa-with-SHA384 covers the truncation direction.
--  Fixtures: openssl req -x509 -newkey ec ... -sha256 / -sha384.

with Ada.Text_IO;      use Ada.Text_IO;
with Ada.Command_Line;
with Interfaces;       use Interfaces;
with SPARKNaCl;        use SPARKNaCl;
with X509;
with SPARKTLS.Cert_Verify;

procedure Test_Cert_Sig_Algos is
   Total, Pass, Fail : Natural := 0;

   procedure Check (Name : String; OK : Boolean) is
   begin
      Total := Total + 1;
      if OK then
         Pass := Pass + 1;
         Put_Line ("  PASS: " & Name);
      else
         Fail := Fail + 1;
         Put_Line ("  FAIL: " & Name);
      end if;
   end Check;

