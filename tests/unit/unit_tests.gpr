with "../../sparktls.gpr";

project Unit_Tests is
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";
   for Exec_Dir use "../../bin/tests";
   for Source_Dirs use (".");
   for Main use ("test_crypto.adb", "test_fiat_p256_kat.adb",
                 "test_fiat_25519_kat.adb", "test_25519_rfc.adb",
                 "test_build_server_hello.adb",
                 "test_parse_client_hello.adb",
                 "test_aes_ni.adb",
                 "test_ghash_ni.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnatn", "-gnatp");
   end Compiler;
end Unit_Tests;
