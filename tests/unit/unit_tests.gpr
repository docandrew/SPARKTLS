with "../../sparktls.gpr";

project Unit_Tests is
   for Create_Missing_Dirs use "True";
   for Object_Dir use "obj";
   for Exec_Dir use "../../bin/tests";
   for Source_Dirs use (".");
   for Main use ("test_crypto.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-O2", "-gnatn", "-gnatp");
   end Compiler;
end Unit_Tests;
