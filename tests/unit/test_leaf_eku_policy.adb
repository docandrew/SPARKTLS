--  Leaf extended key usage policy: CA/Browser Forum TLS Baseline
--  Requirements 7.1.2.7.10 (v2.3.1, Subscriber Certificate Extended Key
--  Usage), https://cabforum.org/working-groups/server/baseline-requirements/requirements/#712710-subscriber-certificate-extended-key-usage
--  A subscriber (TLS server) certificate MUST carry id-kp-serverAuth, MAY
--  carry id-kp-clientAuth, and MUST NOT carry id-kp-codeSigning,
--  id-kp-emailProtection, id-kp-timeStamping, id-kp-OCSPSigning,
--  anyExtendedKeyUsage or Precertificate Signing Certificate
--  (1.3.6.1.4.1.11129.2.4.4); any other purpose is NOT RECOMMENDED and
--  stays accepted. Mode_WebPKI rejects a server leaf with a forbidden
--  purpose (before 2026-11 it accepted all but anyExtendedKeyUsage);
--  Mode_RFC5280 accepts them all (RFC 5280 4.2.1.12 forbids none), and a
--  client leaf is outside the BR's subscriber profile in either mode.
--
--  Fixtures: self-signed P-256 leaves, CN and SAN DNS leaf.test, critical
--  basicConstraints CA:FALSE and keyUsage digitalSignature, made with
--    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -sha256
--      -nodes -days 3650 -outform DER -config <name>.cnf
--  where <name>.cnf sets extendedKeyUsage to the purposes in the name
--  (other = id-kp-ipsecIKE 1.3.6.1.5.5.7.3.17, precert =
--  1.3.6.1.4.1.11129.2.4.4). Validate_Leaf_Policy checks neither the
--  signature nor the dates, so the fixtures never expire for this test.

with Ada.Text_IO;      use Ada.Text_IO;
with Ada.Command_Line;
with SPARKTLS;         use SPARKTLS;
with SPARKTLS.Cert_Verify; use SPARKTLS.Cert_Verify;
with X509;

procedure Test_Leaf_EKU_Policy is
   Total, Pass, Fail : Natural := 0;

   procedure Check (Name : String; OK : Boolean) is
   begin
      Total := Total + 1;
      if OK then
         Pass := Pass + 1;
         Put_Line ("  PASS: " & Name);
      else
         Fail := Fail + 1;
         Put_Line ("  FAIL: " & Name);
      end if;
   end Check;

