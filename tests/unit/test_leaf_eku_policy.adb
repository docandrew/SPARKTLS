   Host : constant String := "leaf.test";

   --  Parse DER and check Validate_Leaf_Policy for Purpose in both modes.
   procedure Case_Leaf
     (Name    : String;
      DER     : X509.Byte_Seq;
      Purpose : Validation_Purpose;
      WebPKI  : Validation_Result;
      RFC5280 : Validation_Result)
   is
      Cert : X509.Certificate;
      OK   : Boolean;
      R    : Validation_Result;
   begin
      X509.Parse (DER, Cert, OK);
      Check (Name & ": parses", OK and then X509.Is_Valid (Cert));
      if not OK then
         return;
      end if;
      R := Validate_Leaf_Policy (Cert, DER, Host, Purpose, Mode_WebPKI);
      Check (Name & ": " & Purpose'Image & " WebPKI " & R'Image
             & " (want " & WebPKI'Image & ")", R = WebPKI);
      R := Validate_Leaf_Policy (Cert, DER, Host, Purpose, Mode_RFC5280);
      Check (Name & ": " & Purpose'Image & " RFC5280 " & R'Image
             & " (want " & RFC5280'Image & ")", R = RFC5280);
   end Case_Leaf;
begin
   Put_Line ("--- SPARKTLS.Cert_Verify.Validate_Leaf_Policy: CABF TLS BR"
             & " 7.1.2.7.10 leaf EKU ---");
   --  MUST serverAuth, MAY clientAuth, other values accepted.
   Case_Leaf ("serverAuth", Server_Only_DER, Purpose_Server, Valid, Valid);
   Case_Leaf ("serverAuth+clientAuth", Server_Client_DER, Purpose_Server,
              Valid, Valid);
   Case_Leaf ("serverAuth+ipsecIKE", Server_Other_DER, Purpose_Server,
              Valid, Valid);
   --  MUST NOT: rejected in WebPKI, accepted under RFC 5280.
   Case_Leaf ("serverAuth+codeSigning", Server_Code_DER, Purpose_Server,
              Err_Wrong_EKU, Valid);
   Case_Leaf ("serverAuth+emailProtection", Server_Email_DER,
              Purpose_Server, Err_Wrong_EKU, Valid);
   Case_Leaf ("serverAuth+timeStamping", Server_Time_DER, Purpose_Server,
              Err_Wrong_EKU, Valid);
   Case_Leaf ("serverAuth+OCSPSigning", Server_OCSP_DER, Purpose_Server,
              Err_Wrong_EKU, Valid);
   Case_Leaf ("serverAuth+precertSigning", Server_Precert_DER,
              Purpose_Server, Err_Wrong_EKU, Valid);
   Case_Leaf ("serverAuth+anyExtendedKeyUsage", Server_Any_DER,
              Purpose_Server, Err_Wrong_EKU, Valid);
   --  Client leaves are outside the subscriber profile: a forbidden
   --  server purpose beside clientAuth stays accepted in WebPKI mode.
   Case_Leaf ("clientAuth+emailProtection", Client_Email_DER,
              Purpose_Client, Valid, Valid);
   Case_Leaf ("clientAuth+emailProtection", Client_Email_DER,
              Purpose_Server, Err_Wrong_EKU, Err_Wrong_EKU);
   Case_Leaf ("serverAuth+codeSigning", Server_Code_DER, Purpose_Client,
              Err_Wrong_EKU, Err_Wrong_EKU);
   New_Line;
   Put_Line ("=== Results: " & Pass'Image & "/" & Total'Image
             & " passed, " & Fail'Image & " failed ===");
   if Fail > 0 then
      Ada.Command_Line.Set_Exit_Status (1);
   end if;
end Test_Leaf_EKU_Policy;
