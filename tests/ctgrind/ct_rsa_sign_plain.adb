--  RSA-2048 PSS signing through the plain-d path (no CRT), d poisoned.
--  Key material: throwaway RSA-2048 pair(s) generated 2026-09-14 with
--    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
--  and split with `openssl pkey -text` into n, d, p, q, dP, dQ, qInv
--  (big-endian, left-padded to 256/128 bytes). The keys exist only in
--  this test source and protect nothing.
procedure Ct_RSA_Sign_Plain is
   K_N : constant Byte_Seq (0 .. 255) :=
     (
      16#AF#, 16#E1#, 16#93#, 16#8C#, 16#CD#, 16#80#, 16#C4#, 16#BC#, 16#60#, 16#22#, 16#0B#, 16#9A#,
      16#4B#, 16#91#, 16#47#, 16#81#, 16#4F#, 16#CB#, 16#FB#, 16#C8#, 16#B7#, 16#F1#, 16#37#, 16#C9#,
