with "../sparktls.gpr";
with "../../sparkentropy/sparkentropy.gpr";

project SPARKTLS_CLI is

   for Source_Dirs use (".");
   for Object_Dir use "../obj/cli";
   for Exec_Dir use "../bin";
   for Create_Missing_Dirs use "True";
   for Main use ("sparktls_cli.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-g", "-O2", "-gnatQ", "-gnatw.X");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end SPARKTLS_CLI;
