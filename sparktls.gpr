with "config/sparktls_config.gpr";
project Sparktls is

   for Library_Name use "Sparktls";
   for Library_Version use Project'Library_Name & ".so." & Sparktls_Config.Crate_Version;

   for Source_Dirs use ("src", "generated");
   for Object_Dir use "obj";
   for Create_Missing_Dirs use "True";
   for Library_Dir use "lib";

   --  Old monolithic test client is now in examples/
   --  for Main use ("src/tls.adb");

   type Library_Type_Type is ("relocatable", "static", "static-pic");
   Library_Type : Library_Type_Type :=
     external ("SPARKTLS_LIBRARY_TYPE", external ("LIBRARY_TYPE", "static"));
   for Library_Kind use Library_Type;

   type Enabled_Kind is ("enabled", "disabled");
   Compile_Checks : Enabled_Kind := External ("SPARKTLS_COMPILE_CHECKS", "disabled");
   Runtime_Checks : Enabled_Kind := External ("SPARKTLS_RUNTIME_CHECKS", "disabled");
   Style_Checks : Enabled_Kind := External ("SPARKTLS_STYLE_CHECKS", "disabled");
   Contracts_Checks : Enabled_Kind := External ("SPARKTLS_CONTRACTS", "disabled");

   type Build_Kind is ("debug", "optimize");
   Build_Mode : Build_Kind := External ("SPARKTLS_BUILD_MODE", "optimize");

   Compile_Checks_Switches := ();
   case Compile_Checks is
      when "enabled" =>
         Compile_Checks_Switches :=
           ("-gnatwa",  -- All warnings
            "-gnatVa",  -- All validity checks
            "-gnatwe"); -- Warnings as errors
      when others => null;
   end case;

   Runtime_Checks_Switches := ();
   case Runtime_Checks is
      when "enabled" => null;
      when others =>
         Runtime_Checks_Switches :=
           ("-gnatp"); -- Suppress checks
   end case;

   Style_Checks_Switches := ();
   case Style_Checks is
      when "enabled" =>
         Style_Checks_Switches :=
           ("-gnatyg",   -- GNAT Style checks
            "-gnaty-d",  -- Disable no DOS line terminators
            "-gnatyM80", -- Maximum line length
            "-gnatyO");  -- Overriding subprograms explicitly marked as such
      when others => null;
   end case;

   Contracts_Switches := ();
   case Contracts_Checks is
      when "enabled" =>
         Contracts_Switches :=
           ("-gnata"); --  Enable assertions and contracts
      when others => null;
   end case;

   Build_Switches := ();
   case Build_Mode is
      when "optimize" =>
         Build_Switches := ("-O3",     -- Optimization
                            "-gnatn", -- Enable inlining
                            "-march=native",
                            "-mtune=native");
      when "debug" =>
         Build_Switches := ("-g",   -- Debug info
                            "-Og"); -- No optimization
   end case;

   package Compiler is
      for Default_Switches ("Ada") use
        Compile_Checks_Switches &
        Build_Switches &
        Runtime_Checks_Switches &
        Style_Checks_Switches &
        Contracts_Switches &
        ("-gnatw.X", -- Disable warnings for No_Exception_Propagation
         "-gnatQ");  -- Don't quit. Generate ALI and tree files even if illegalities
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   --  RecordFlux-generated code IS analysed by gnatprove, along with
   --  everything in src/. It is not excluded and should not be.
   --
   --  This package used to carry
   --     for Excluded_Source_List_File use "excluded_from_proof.list";
   --  together with a comment saying generated code was excluded and
   --  suggesting "ls generated/ > excluded_from_proof.list" to rebuild the
   --  list. That file never existed and was never committed, so the
   --  directive did nothing -- generated units were being proved the whole
   --  time, and the comment described the opposite of the actual behaviour.
   --  Removed rather than repaired: materialising the list would silence
   --  every generated-unit finding in one command and make a "fully proven"
   --  claim that proves strictly less.
   --
   --  Findings as of the 2026-08-16 full-project run (level 2, see
   --  findings_Aug_16.txt), 145 total:
   --     137  generated (rflx-*)  -- server_hello 27, tls_record 9,
   --                                 client_hello 6, and a long tail
   --       7  sparknacl (dependency, not ours)
   --       1  owned -- sparktls-handshake-tls12.ads:517 Reasm_Coherent,
   --          which is MARGINAL rather than unprovable: identical runs on an
   --          idle box gave proved/failed/proved/failed/proved/proved/proved.
   --          See the --steps note below.
   --
   --  The generated count came down from 186 via the Buffer.all guards in
   --  generated/rflx-tls_handshake-server_hello.ads; see generated/README.md.
   --  Functional correctness of generated code is covered by the integration
   --  suite (TLS interop with OpenSSL) and BoGo.
   package Prove is
      --  Per RFLX docs § "First steps": throw multiple provers, no
      --  step limit, generous per-VC timeout, suppress counterexamples
      --  for speed. RFLX-generated specs need this profile.
      --
      --  KNOWN ISSUE -- "--steps=0" makes findings non-reproducible.
      --  With no step limit the only bound is wall-clock "--timeout=180",
      --  so a VC that needs a large fraction of that budget can land either
      --  way depending on machine load, prover scheduling, and solver
      --  heuristics. Measured 2026-08-16: sparktls-handshake-tls12.ads:517
      --  gave proved/failed/proved/failed/proved/proved/proved across
      --  identical invocations on an idle box. A findings count produced
      --  this way describes one run, not the code.
      --
      --  Steps are deterministic prover work units, so bounding by
      --  "--steps=N" (keeping a timeout as a backstop) makes the same tree
      --  yield the same verdict on any machine under any load -- a marginal
      --  VC then fails consistently and can be fixed, instead of flapping.
      --  Not changed yet: picking N wants a calibration run, since too low
      --  a value turns currently-proved checks into findings.
      --  NOTE: --timeout here overrides whatever --level implies, so
      --  "--level=2" and "--level=1" resolve to the same configuration.
      for Proof_Switches ("Ada") use
        ("-j0",
         "--prover=z3,cvc5,altergo",
         "--steps=0",
         "--timeout=180",
         "--memlimit=2000",
         "--counterexamples=off");
   end Prove;

end Sparktls;
