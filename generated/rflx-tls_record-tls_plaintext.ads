       and Ctx.Last = Ctx.Last'Old
       and Valid_Next (Ctx, F_Fragment) = Valid_Next (Ctx, F_Fragment)'Old
       and Get_Tag (Ctx) = Get_Tag (Ctx)'Old
       and Get_Legacy_Record_Version (Ctx) = Get_Legacy_Record_Version (Ctx)'Old
       and Get_Length (Ctx) = Get_Length (Ctx)'Old
       and Field_First (Ctx, F_Fragment) = Field_First (Ctx, F_Fragment)'Old;

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor
   with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors (Ctx : Context) return Field_Cursors
   with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor
   with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

private

   type Cursor_State is (S_Valid, S_Well_Formed, S_Invalid, S_Incomplete);

   type Field_Cursor is
      record
         State : Cursor_State := S_Invalid;
         First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First;
         Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First;
         Value : RFLX_Types.Base_Integer := 0;
      end record;

   type Field_Cursors is array (Virtual_Field) of Field_Cursor;

   function Well_Formed (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid
      or Cursor.State = S_Well_Formed);

   function Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid);

   function Invalid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Invalid
      or Cursor.State = S_Incomplete);

   pragma Warnings (Off, "postcondition does not mention function result");

   function Cursors_Invariant (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length) return Boolean is
     ((for all F in Field =>
          (if
              Well_Formed (Cursors (F))
           then
              Cursors (F).First >= First
              and Cursors (F).Last <= Verified_Last
              and Cursors (F).First <= Cursors (F).Last + 1
              and Valid_Value (F, Cursors (F).Value))))
   with
     Post =>
       True;

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (Off, "formal parameter ""*"" is not referenced");

   pragma Warnings (Off, "postcondition does not mention function result");

   pragma Warnings (Off, "unused variable ""*""");

   function Valid_Predecessors_Invariant (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return Boolean is
     ((if Well_Formed (Cursors (F_Prefix)) then True)
      and then (if Well_Formed (Cursors (F_Tag)) then Valid (Cursors (F_Prefix)))
      and then (if Well_Formed (Cursors (F_Legacy_Record_Version)) then Valid (Cursors (F_Tag)))
      and then (if
                   Well_Formed (Cursors (F_Epoch))
                then
                   (Valid (Cursors (F_Legacy_Record_Version))
                    and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                    and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                    and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                    and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1))))
      and then (if Well_Formed (Cursors (F_Sequence_Number)) then Valid (Cursors (F_Epoch)))
      and then (if
                   Well_Formed (Cursors (F_Length))
                then
                   (Valid (Cursors (F_Legacy_Record_Version))
                    and then (RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                              or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                              or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                              or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
                    and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Tls12_Cid))
                    and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.ACK)))
                   or Valid (Cursors (F_Sequence_Number)))
      and then (if
                   Well_Formed (Cursors (F_Encrypted_Record))
                then
                   (Valid (Cursors (F_Length))
                    and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                    and then (RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                              or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.DTLS_1_2)))))
      and then (if
                   Well_Formed (Cursors (F_Fragment))
                then
                   (Valid (Cursors (F_Length))
                    and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                    and then RFLX_Types.Base_Integer (Cursors (F_Length).Value) <= 16384)))
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last),
     Post =>
       True;

   pragma Warnings (On, "unused variable ""*""");

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (On, "formal parameter ""*"" is not referenced");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Next_Internal (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Fld : Field) return Boolean is
     (case Fld is
          when F_Prefix =>
             True,
          when F_Tag =>
             (Valid (Cursors (F_Prefix))
              and then True),
          when F_Legacy_Record_Version =>
             (Valid (Cursors (F_Tag))
              and then True),
          when F_Epoch =>
             (Valid (Cursors (F_Legacy_Record_Version))
              and then (RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                        and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                        and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                        and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))),
          when F_Sequence_Number =>
             (Valid (Cursors (F_Epoch))
              and then True),
          when F_Length =>
             (Valid (Cursors (F_Legacy_Record_Version))
              and then ((RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                         or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                         or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                         or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
                        and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Tls12_Cid))
                        and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.ACK))))
             or (Valid (Cursors (F_Sequence_Number))
                 and then True),
          when F_Encrypted_Record =>
             (Valid (Cursors (F_Length))
              and then (RFLX_Types.Base_Integer (Cursors (F_Tag).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                        and then (RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                                  or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.DTLS_1_2))))),
          when F_Fragment =>
             (Valid (Cursors (F_Length))
              and then (RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                        and then RFLX_Types.Base_Integer (Cursors (F_Length).Value) <= 16384)))
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last),
     Post =>
       True;

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (Off, "unused variable ""*""");

   pragma Warnings (Off, "formal parameter ""*"" is not referenced");

   function Field_Size_Internal (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Fld : Field) return RFLX_Types.Bit_Length'Base is
     (case Fld is
          when F_Prefix =>
             3,
          when F_Tag =>
             5,
          when F_Legacy_Record_Version | F_Epoch =>
             16,
          when F_Sequence_Number =>
             48,
          when F_Length =>
             16,
          when F_Encrypted_Record | F_Fragment =>
             RFLX_Types.Bit_Length (Cursors (F_Length).Value) * 8)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, Fld);

   pragma Warnings (On, "formal parameter ""*"" is not referenced");

   pragma Warnings (On, "unused variable ""*""");

   pragma Warnings (Off, "postcondition does not mention function result");

   pragma Warnings (Off, "unused variable ""*""");

   pragma Warnings (Off, "no recursive call visible");

   pragma Warnings (Off, "formal parameter ""*"" is not referenced");

   function Field_First_Prefix (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Prefix);

   function Field_First_Tag (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 3)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Tag);

   function Field_First_Legacy_Record_Version (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 8)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Legacy_Record_Version);

   function Field_First_Epoch (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 24)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Epoch);

   function Field_First_Sequence_Number (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (First + 40)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Sequence_Number);

   function Field_First_Length (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (if
          Well_Formed (Cursors (F_Legacy_Record_Version))
          and then ((RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                     or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                     or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                     or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
                    and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Tls12_Cid))
                    and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.ACK)))
       then
          First + 24
       elsif
          Well_Formed (Cursors (F_Sequence_Number))
          and then True
       then
          First + 88
       else
          RFLX_Types.Unreachable)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Length);

   function Field_First_Encrypted_Record (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (Field_First_Length (Cursors, First, Verified_Last, Written_Last) + 16)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Encrypted_Record);

   function Field_First_Fragment (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return RFLX_Types.Bit_Index'Base is
     (Field_First_Length (Cursors, First, Verified_Last, Written_Last) + 16)
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, F_Fragment);

   function Field_First_Internal (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Fld : Field) return RFLX_Types.Bit_Index'Base is
     (case Fld is
          when F_Prefix =>
             Field_First_Prefix (Cursors, First, Verified_Last, Written_Last),
          when F_Tag =>
             Field_First_Tag (Cursors, First, Verified_Last, Written_Last),
          when F_Legacy_Record_Version =>
             Field_First_Legacy_Record_Version (Cursors, First, Verified_Last, Written_Last),
          when F_Epoch =>
             Field_First_Epoch (Cursors, First, Verified_Last, Written_Last),
          when F_Sequence_Number =>
             Field_First_Sequence_Number (Cursors, First, Verified_Last, Written_Last),
          when F_Length =>
             Field_First_Length (Cursors, First, Verified_Last, Written_Last),
          when F_Encrypted_Record =>
             Field_First_Encrypted_Record (Cursors, First, Verified_Last, Written_Last),
          when F_Fragment =>
             Field_First_Fragment (Cursors, First, Verified_Last, Written_Last))
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, Fld),
     Post =>
       True;

   pragma Warnings (On, "formal parameter ""*"" is not referenced");

   pragma Warnings (On, "no recursive call visible");

   pragma Warnings (On, "unused variable ""*""");

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (Off, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Context (Buffer_First, Buffer_Last : RFLX_Types.Index; First : RFLX_Types.Bit_Index; Last : RFLX_Types.Bit_Length; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Buffer : RFLX_Types.Bytes_Ptr; Cursors : Field_Cursors) return Boolean is
     ((if
          Buffer /= null
       then
          Buffer'Length > 0
          and Buffer'First = Buffer_First
          and Buffer'Last = Buffer_Last)
      and then (RFLX_Types.To_Index (First) >= Buffer_First
                and RFLX_Types.To_Index (Last) <= Buffer_Last
                and Buffer_Last < RFLX_Types.Index'Last
                and First <= Last + 1
                and Last < RFLX_Types.Bit_Index'Last
                and First rem RFLX_Types.Byte'Size = 1
                and Last rem RFLX_Types.Byte'Size = 0)
      and then First - 1 <= Verified_Last
      and then First - 1 <= Written_Last
      and then Verified_Last <= Written_Last
      and then Written_Last <= Last
      and then First rem RFLX_Types.Byte'Size = 1
      and then Last rem RFLX_Types.Byte'Size = 0
      and then Verified_Last rem RFLX_Types.Byte'Size = 0
      and then Written_Last rem RFLX_Types.Byte'Size = 0
      and then Cursors_Invariant (Cursors, First, Verified_Last)
      and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
      and then ((if
                    Well_Formed (Cursors (F_Prefix))
                 then
                    (Cursors (F_Prefix).Last - Cursors (F_Prefix).First + 1 = 3
                     and then Cursors (F_Prefix).First = First))
                and then (if
                             Well_Formed (Cursors (F_Tag))
                          then
                             (Cursors (F_Tag).Last - Cursors (F_Tag).First + 1 = 5
                              and then Cursors (F_Tag).First = Cursors (F_Prefix).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Legacy_Record_Version))
                          then
                             (Cursors (F_Legacy_Record_Version).Last - Cursors (F_Legacy_Record_Version).First + 1 = 16
                              and then Cursors (F_Legacy_Record_Version).First = Cursors (F_Tag).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Epoch))
                          then
                             (Cursors (F_Epoch).Last - Cursors (F_Epoch).First + 1 = 16
                              and then Cursors (F_Epoch).First = Cursors (F_Legacy_Record_Version).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Sequence_Number))
                          then
                             (Cursors (F_Sequence_Number).Last - Cursors (F_Sequence_Number).First + 1 = 48
                              and then Cursors (F_Sequence_Number).First = Cursors (F_Epoch).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Length))
                          then
                             (if
                                 Well_Formed (Cursors (F_Legacy_Record_Version))
                                 and then ((RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                                            or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                                            or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                                            or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
                                           and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Tls12_Cid))
                                           and then RFLX_Types.Base_Integer (Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.ACK)))
                              then
                                 Cursors (F_Length).Last - Cursors (F_Length).First + 1 = 16
                                 and then Cursors (F_Length).First = Cursors (F_Legacy_Record_Version).Last + 1)
                             and then (if
                                          Well_Formed (Cursors (F_Sequence_Number))
                                          and then True
                                       then
                                          Cursors (F_Length).Last - Cursors (F_Length).First + 1 = 16
                                          and then Cursors (F_Length).First = Cursors (F_Sequence_Number).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Encrypted_Record))
                          then
                             (Cursors (F_Encrypted_Record).Last - Cursors (F_Encrypted_Record).First + 1 = RFLX_Types.Bit_Length (Cursors (F_Length).Value) * 8
                              and then Cursors (F_Encrypted_Record).First = Cursors (F_Length).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Fragment))
                          then
                             (Cursors (F_Fragment).Last - Cursors (F_Fragment).First + 1 = RFLX_Types.Bit_Length (Cursors (F_Length).Value) * 8
                              and then Cursors (F_Fragment).First = Cursors (F_Length).Last + 1))))
   with
     Post =>
       True;

   pragma Warnings (On, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (On, "postcondition does not mention function result");

   type Context (Buffer_First, Buffer_Last : RFLX_Types.Index := RFLX_Types.Index'First; First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First; Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First) is
      record
         Verified_Last : RFLX_Types.Bit_Length := First - 1;
         Written_Last : RFLX_Types.Bit_Length := First - 1;
         Buffer : RFLX_Types.Bytes_Ptr := null;
         Cursors : Field_Cursors := (others => <>);
      end record
   with
     Dynamic_Predicate =>
       Valid_Context (Context.Buffer_First, Context.Buffer_Last, Context.First, Context.Last, Context.Verified_Last, Context.Written_Last, Context.Buffer, Context.Cursors);

   function Initialized (Ctx : Context) return Boolean is
     (Ctx.Verified_Last = Ctx.First - 1
      and then Valid_Next (Ctx, F_Prefix)
      and then RFLX.TLS_Record.TLS_Plaintext.Field_First (Ctx, RFLX.TLS_Record.TLS_Plaintext.F_Prefix) rem RFLX_Types.Byte'Size = 1
      and then Available_Space (Ctx, F_Prefix) = Ctx.Last - Ctx.First + 1
      and then (for all F in Field =>
                   Invalid (Ctx, F)));

   function Read (Ctx : Context) return RFLX_Types.Bytes is
     (Ctx.Buffer.all (RFLX_Types.To_Index (Ctx.First) .. RFLX_Types.To_Index (Ctx.Verified_Last)));

   function Has_Buffer (Ctx : Context) return Boolean is
     (Ctx.Buffer /= null);

   function Buffer_Length (Ctx : Context) return RFLX_Types.Length is
     (Ctx.Buffer'Length);

   function Buffer_Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Buffer'Length * RFLX_Types.Byte'Size);

   function Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last - Ctx.First + 1);

   function Byte_Size (Ctx : Context) return RFLX_Types.Length is
     (RFLX_Types.To_Length (Size (Ctx)));

   function Message_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last);

   function Written_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Written_Last);

   function Valid_Value (Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     (case Fld is
          when F_Prefix =>
             RFLX.TLS_Record.Valid_Plaintext_Prefix (Val),
          when F_Tag =>
             RFLX.TLS_Record.Valid_Plaintext_Content_Type (Val),
          when F_Legacy_Record_Version =>
             RFLX.TLS_Common.Valid_Protocol_Version (Val),
          when F_Epoch =>
             RFLX.TLS_Record.Valid_Plaintext_Epoch (Val),
          when F_Sequence_Number =>
             RFLX.TLS_Record.Valid_Plaintext_Sequence_Number (Val),
          when F_Length =>
             RFLX.TLS_Record.Valid_Plaintext_Length (Val),
          when F_Encrypted_Record | F_Fragment =>
             True);

   function Field_Condition (Ctx : Context; Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     (case Fld is
          when F_Prefix | F_Tag =>
             True,
          when F_Legacy_Record_Version =>
             (Val /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
              and then Val /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
              and then Val /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
              and then Val /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
             or else ((Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                       or else Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                       or else Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                       or else Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
                      and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Tls12_Cid))
                      and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.ACK))),
          when F_Epoch | F_Sequence_Number =>
             True,
          when F_Length =>
             (RFLX_Types.Base_Integer (Ctx.Cursors (F_Tag).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
              and then (RFLX_Types.Base_Integer (Ctx.Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                        or else RFLX_Types.Base_Integer (Ctx.Cursors (F_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.DTLS_1_2))))
             or else (RFLX_Types.Base_Integer (Ctx.Cursors (F_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                      and then Val <= 16384),
          when F_Encrypted_Record | F_Fragment =>
             True);

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_Size_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Fld));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     (Field_First_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Fld));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Next_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Well_Formed (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Well_Formed (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Well_Formed);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Well_Formed_Message (Ctx : Context) return Boolean is
     (Well_Formed (Ctx, F_Encrypted_Record)
      or else Well_Formed (Ctx, F_Fragment));

   function Valid_Message (Ctx : Context) return Boolean is
     (Valid (Ctx, F_Encrypted_Record)
      or else Valid (Ctx, F_Fragment));

   function Incomplete_Message (Ctx : Context) return Boolean is
     ((for some F in Field =>
          Incomplete (Ctx, F)));

   function Get_Prefix (Ctx : Context) return RFLX.TLS_Record.Plaintext_Prefix is
     (To_Actual (Ctx.Cursors (F_Prefix).Value));

   function Get_Tag (Ctx : Context) return RFLX.TLS_Record.Plaintext_Content_Type is
     (To_Actual (Ctx.Cursors (F_Tag).Value));

   function Get_Legacy_Record_Version (Ctx : Context) return RFLX.TLS_Common.Protocol_Version is
     (To_Actual (Ctx.Cursors (F_Legacy_Record_Version).Value));

   function Get_Epoch (Ctx : Context) return RFLX.TLS_Record.Plaintext_Epoch is
     (To_Actual (Ctx.Cursors (F_Epoch).Value));

   function Get_Sequence_Number (Ctx : Context) return RFLX.TLS_Record.Plaintext_Sequence_Number is
     (To_Actual (Ctx.Cursors (F_Sequence_Number).Value));

   function Get_Length (Ctx : Context) return RFLX.TLS_Record.Plaintext_Length is
     (To_Actual (Ctx.Cursors (F_Length).Value));

   function Valid_Size (Ctx : Context; Fld : Field; Size : RFLX_Types.Bit_Length) return Boolean is
     (Size = Field_Size (Ctx, Fld))
   with
     Pre =>
       RFLX.TLS_Record.TLS_Plaintext.Valid_Next (Ctx, Fld);

   function Valid_Length (Ctx : Context; Fld : Field; Length : RFLX_Types.Length) return Boolean is
     (Valid_Size (Ctx, Fld, RFLX_Types.To_Bit_Length (Length)));

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor is
     (Ctx.Cursors (Fld));

   function Context_Cursors (Ctx : Context) return Field_Cursors is
     (Ctx.Cursors);

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor is
     (Cursors (Fld));

end RFLX.TLS_Record.TLS_Plaintext;
