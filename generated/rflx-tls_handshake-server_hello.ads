       and then RFLX.TLS_Handshake.Server_Hello.Field_Condition (Ctx, RFLX.TLS_Handshake.Server_Hello.F_HRR_Extensions_TLS, 0, (1 .. 0 => 0)),
     Post =>
       not RFLX.TLS_Handshake.Server_Hello.Has_Buffer (Ctx)
