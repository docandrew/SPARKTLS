private

   type Cursor_State is (S_Valid, S_Well_Formed, S_Invalid, S_Incomplete);

   type Field_Cursor is
      record
         State : Cursor_State := S_Invalid;
         First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First;
         Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First;
         Value : RFLX_Types.Base_Integer := 0;
      end record;

   type Field_Cursors is array (Virtual_Field) of Field_Cursor;

   function Well_Formed (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid
      or Cursor.State = S_Well_Formed);

   function Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid);

   function Invalid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Invalid
      or Cursor.State = S_Incomplete);

   pragma Warnings (Off, "postcondition does not mention function result");

   function Cursors_Invariant (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length) return Boolean is
     ((for all F in Field =>
          (if
              Well_Formed (Cursors (F))
           then
              Cursors (F).First >= First
              and Cursors (F).Last <= Verified_Last
              and Cursors (F).First <= Cursors (F).Last + 1
              and Valid_Value (F, Cursors (F).Value))))
   with
     Post =>
       True;

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (Off, "formal parameter ""*"" is not referenced");

   pragma Warnings (Off, "postcondition does not mention function result");

   pragma Warnings (Off, "unused variable ""*""");

   function Valid_Predecessors_Invariant (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Buffer : RFLX_Types.Bytes_Ptr) return Boolean is
     ((if Well_Formed (Cursors (F_Legacy_Version)) then True)
      and then (if
                   Well_Formed (Cursors (F_Random))
                then
                   (Valid (Cursors (F_Legacy_Version))
                    and then (RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                              or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.DTLS_1_2)))))
      and then (if Well_Formed (Cursors (F_Legacy_Session_ID_Length)) then Well_Formed (Cursors (F_Random)))
      and then (if Well_Formed (Cursors (F_Legacy_Session_ID)) then Valid (Cursors (F_Legacy_Session_ID_Length)))
      and then (if
                   Well_Formed (Cursors (F_Cipher_Suite_DTLS_Suite))
                then
                   (Well_Formed (Cursors (F_Legacy_Session_ID))
                    and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                    and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                    and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                    and then RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1))))
      and then (if
                   Well_Formed (Cursors (F_Cipher_Suite_TLS_Suite))
                then
                   (Well_Formed (Cursors (F_Legacy_Session_ID))
                    and then (RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                              or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                              or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                              or else RFLX_Types.Base_Integer (Cursors (F_Legacy_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))))
      and then (if
                   Well_Formed (Cursors (F_Legacy_Compression_Method))
                then
                   (Valid (Cursors (F_Cipher_Suite_DTLS_Suite))
                    and then RFLX_Types.Base_Integer (Cursors (F_Cipher_Suite_DTLS_Suite).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.Tls_Parameters.TLS_GOSTR341112_256_WITH_MAGMA_MGM_S))
                    and then RFLX_Types.Base_Integer (Cursors (F_Cipher_Suite_DTLS_Suite).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.Tls_Parameters.TLS_GOSTR341112_256_WITH_KUZNYECHIK_MGM_S))
                    and then RFLX_Types.Base_Integer (Cursors (F_Cipher_Suite_DTLS_Suite).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.Tls_Parameters.TLS_GOSTR341112_256_WITH_MAGMA_MGM_L))
                    and then RFLX_Types.Base_Integer (Cursors (F_Cipher_Suite_DTLS_Suite).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.Tls_Parameters.TLS_GOSTR341112_256_WITH_KUZNYECHIK_MGM_L))
                    and then RFLX_Types.Base_Integer (Cursors (F_Cipher_Suite_DTLS_Suite).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.Tls_Parameters.TLS_GOSTR341112_256_WITH_28147_CNT_IMIT))
                    and then RFLX_Types.Base_Integer (Cursors (F_Cipher_Suite_DTLS_Suite).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.Tls_Parameters.TLS_GOSTR341112_256_WITH_MAGMA_CTR_OMAC))
