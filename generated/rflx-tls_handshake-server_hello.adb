       and then Field_First (Ctx, F_Random) = Field_First (Ctx, F_Random)'Old
   is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Random);
      Last : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Random) + RFLX_Types.Bit_Length (Length) * RFLX_Types.Byte'Size - 1;
   begin
      pragma Assert (Last mod RFLX_Types.Byte'Size = 0);
      Reset_Dependent_Fields (Ctx, F_Random);
      pragma Warnings (Off, "attribute Update is an obsolescent feature");
      Ctx := Ctx'Update (Verified_Last => Last, Written_Last => Last);
      pragma Warnings (On, "attribute Update is an obsolescent feature");
      Ctx.Cursors (F_Random) := (State => S_Well_Formed, First => First, Last => Last, Value => 0);
   end Initialize_Random_Private;

   procedure Initialize_Random (Ctx : in out Context) is
   begin
      Initialize_Random_Private (Ctx, RFLX_Types.To_Length (Field_Size (Ctx, F_Random)));
   end Initialize_Random;

   procedure Initialize_Legacy_Session_ID_Private (Ctx : in out Context; Length : RFLX_Types.Length)
   with
     Pre =>
       not Ctx'Constrained
       and then RFLX.TLS_Handshake.Server_Hello.Has_Buffer (Ctx)
       and then RFLX.TLS_Handshake.Server_Hello.Valid_Next (Ctx, RFLX.TLS_Handshake.Server_Hello.F_Legacy_Session_ID)
       and then RFLX.TLS_Handshake.Server_Hello.Valid_Length (Ctx, RFLX.TLS_Handshake.Server_Hello.F_Legacy_Session_ID, Length)
       and then RFLX_Types.To_Length (RFLX.TLS_Handshake.Server_Hello.Available_Space (Ctx, RFLX.TLS_Handshake.Server_Hello.F_Legacy_Session_ID)) >= Length,
     Post =>
       Has_Buffer (Ctx)
       and then Well_Formed (Ctx, F_Legacy_Session_ID)
       and then Field_Size (Ctx, F_Legacy_Session_ID) = RFLX_Types.To_Bit_Length (Length)
       and then Ctx.Verified_Last = Field_Last (Ctx, F_Legacy_Session_ID)
       and then Invalid (Ctx, F_Cipher_Suite_TLS_Suite)
       and then Invalid (Ctx, F_Legacy_Compression_Method)
       and then Invalid (Ctx, F_Extensions_Length)
       and then Invalid (Ctx, F_Extensions_TLS)
       and then Valid_Next (Ctx, F_Cipher_Suite_TLS_Suite)
       and then Ctx.Buffer_First = Ctx.Buffer_First'Old
       and then Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and then Ctx.First = Ctx.First'Old
       and then Ctx.Last = Ctx.Last'Old
       and then Valid_Next (Ctx, F_Legacy_Session_ID) = Valid_Next (Ctx, F_Legacy_Session_ID)'Old
       and then Get_Legacy_Version (Ctx) = Get_Legacy_Version (Ctx)'Old
       and then Get_Legacy_Session_ID_Length (Ctx) = Get_Legacy_Session_ID_Length (Ctx)'Old
       and then Field_First (Ctx, F_Legacy_Session_ID) = Field_First (Ctx, F_Legacy_Session_ID)'Old
   is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Legacy_Session_ID);
      Last : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Legacy_Session_ID) + RFLX_Types.Bit_Length (Length) * RFLX_Types.Byte'Size - 1;
   begin
      pragma Assert (Last mod RFLX_Types.Byte'Size = 0);
      Reset_Dependent_Fields (Ctx, F_Legacy_Session_ID);
      pragma Warnings (Off, "attribute Update is an obsolescent feature");
      Ctx := Ctx'Update (Verified_Last => Last, Written_Last => Last);
      pragma Warnings (On, "attribute Update is an obsolescent feature");
      Ctx.Cursors (F_Legacy_Session_ID) := (State => S_Well_Formed, First => First, Last => Last, Value => 0);
   end Initialize_Legacy_Session_ID_Private;

   procedure Initialize_Legacy_Session_ID (Ctx : in out Context) is
   begin
      Initialize_Legacy_Session_ID_Private (Ctx, RFLX_Types.To_Length (Field_Size (Ctx, F_Legacy_Session_ID)));
   end Initialize_Legacy_Session_ID;

   procedure Initialize_Extensions_TLS_Private (Ctx : in out Context; Length : RFLX_Types.Length)
   with
     Pre =>
       not Ctx'Constrained
       and then RFLX.TLS_Handshake.Server_Hello.Has_Buffer (Ctx)
       and then RFLX.TLS_Handshake.Server_Hello.Valid_Next (Ctx, RFLX.TLS_Handshake.Server_Hello.F_Extensions_TLS)
       and then RFLX.TLS_Handshake.Server_Hello.Valid_Length (Ctx, RFLX.TLS_Handshake.Server_Hello.F_Extensions_TLS, Length)
       and then RFLX_Types.To_Length (RFLX.TLS_Handshake.Server_Hello.Available_Space (Ctx, RFLX.TLS_Handshake.Server_Hello.F_Extensions_TLS)) >= Length,
     Post =>
       Has_Buffer (Ctx)
       and then Well_Formed (Ctx, F_Extensions_TLS)
       and then Field_Size (Ctx, F_Extensions_TLS) = RFLX_Types.To_Bit_Length (Length)
       and then Ctx.Verified_Last = Field_Last (Ctx, F_Extensions_TLS)
       and then Ctx.Buffer_First = Ctx.Buffer_First'Old
       and then Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and then Ctx.First = Ctx.First'Old
       and then Ctx.Last = Ctx.Last'Old
       and then Valid_Next (Ctx, F_Extensions_TLS) = Valid_Next (Ctx, F_Extensions_TLS)'Old
       and then Get_Legacy_Version (Ctx) = Get_Legacy_Version (Ctx)'Old
       and then Get_Legacy_Session_ID_Length (Ctx) = Get_Legacy_Session_ID_Length (Ctx)'Old
       and then Get_Cipher_Suite_TLS_Suite (Ctx) = Get_Cipher_Suite_TLS_Suite (Ctx)'Old
       and then Get_Extensions_Length (Ctx) = Get_Extensions_Length (Ctx)'Old
       and then Field_First (Ctx, F_Extensions_TLS) = Field_First (Ctx, F_Extensions_TLS)'Old
   is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Extensions_TLS);
      Last : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Extensions_TLS) + RFLX_Types.Bit_Length (Length) * RFLX_Types.Byte'Size - 1;
   begin
      pragma Assert (Last mod RFLX_Types.Byte'Size = 0);
      Reset_Dependent_Fields (Ctx, F_Extensions_TLS);
      pragma Warnings (Off, "attribute Update is an obsolescent feature");
      Ctx := Ctx'Update (Verified_Last => Last, Written_Last => Last);
      pragma Warnings (On, "attribute Update is an obsolescent feature");
      Ctx.Cursors (F_Extensions_TLS) := (State => S_Well_Formed, First => First, Last => Last, Value => 0);
   end Initialize_Extensions_TLS_Private;

   procedure Initialize_Extensions_TLS (Ctx : in out Context) is
   begin
      Initialize_Extensions_TLS_Private (Ctx, RFLX_Types.To_Length (Field_Size (Ctx, F_Extensions_TLS)));
   end Initialize_Extensions_TLS;

   procedure Set_Random (Ctx : in out Context; Data : RFLX_Types.Bytes) is
      Buffer_First : constant RFLX_Types.Index := RFLX_Types.To_Index (Field_First (Ctx, F_Random));
      Buffer_Last : constant RFLX_Types.Index := Buffer_First + Data'Length - 1;
   begin
      Initialize_Random_Private (Ctx, Data'Length);
      pragma Assert (Buffer_Last = RFLX_Types.To_Index (Field_Last (Ctx, F_Random)));
      Ctx.Buffer.all (Buffer_First .. Buffer_Last) := Data;
      pragma Assert (Ctx.Buffer.all (RFLX_Types.To_Index (Field_First (Ctx, F_Random)) .. RFLX_Types.To_Index (Field_Last (Ctx, F_Random))) = Data);
   end Set_Random;

   procedure Set_Legacy_Session_ID (Ctx : in out Context; Data : RFLX_Types.Bytes) is
      Buffer_First : constant RFLX_Types.Index := RFLX_Types.To_Index (Field_First (Ctx, F_Legacy_Session_ID));
      Buffer_Last : constant RFLX_Types.Index := Buffer_First + Data'Length - 1;
   begin
      Initialize_Legacy_Session_ID_Private (Ctx, Data'Length);
      pragma Assert (Buffer_Last = RFLX_Types.To_Index (Field_Last (Ctx, F_Legacy_Session_ID)));
      Ctx.Buffer.all (Buffer_First .. Buffer_Last) := Data;
      pragma Assert (Ctx.Buffer.all (RFLX_Types.To_Index (Field_First (Ctx, F_Legacy_Session_ID)) .. RFLX_Types.To_Index (Field_Last (Ctx, F_Legacy_Session_ID))) = Data);
   end Set_Legacy_Session_ID;

   procedure Generic_Set_Random (Ctx : in out Context; Length : RFLX_Types.Length) is
      First : constant RFLX_Types.Index := RFLX_Types.To_Index (Field_First (Ctx, F_Random));
   begin
      if Length > 0 then
         Process_Random (Ctx.Buffer.all (First .. First + RFLX_Types.Index (Length) - 1));
      end if;
      pragma Assert (RFLX.TLS_Handshake.Server_Hello.Valid_Length (Ctx, RFLX.TLS_Handshake.Server_Hello.F_Random, Length));
      Initialize_Random_Private (Ctx, Length);
   end Generic_Set_Random;

   procedure Generic_Set_Legacy_Session_ID (Ctx : in out Context; Length : RFLX_Types.Length) is
      First : constant RFLX_Types.Index := RFLX_Types.To_Index (Field_First (Ctx, F_Legacy_Session_ID));
   begin
      if Length > 0 then
         Process_Legacy_Session_ID (Ctx.Buffer.all (First .. First + RFLX_Types.Index (Length) - 1));
      end if;
      pragma Assert (RFLX.TLS_Handshake.Server_Hello.Valid_Length (Ctx, RFLX.TLS_Handshake.Server_Hello.F_Legacy_Session_ID, Length));
      Initialize_Legacy_Session_ID_Private (Ctx, Length);
   end Generic_Set_Legacy_Session_ID;

   procedure Switch_To_Extensions_TLS (Ctx : in out Context; Seq_Ctx : out RFLX.TLS_Handshake.SH_Extensions_TLS.Context) is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Extensions_TLS);
      Last : constant RFLX_Types.Bit_Index := Field_Last (Ctx, F_Extensions_TLS);
      Buffer : RFLX_Types.Bytes_Ptr;
   begin
      if Invalid (Ctx, F_Extensions_TLS) then
         Reset_Dependent_Fields (Ctx, F_Extensions_TLS);
         pragma Warnings (Off, "attribute Update is an obsolescent feature");
         Ctx := Ctx'Update (Verified_Last => Last, Written_Last => RFLX_Types.Bit_Length'Max (Ctx.Written_Last, Last));
         pragma Warnings (On, "attribute Update is an obsolescent feature");
         Ctx.Cursors (F_Extensions_TLS) := (State => S_Well_Formed, First => First, Last => Last, Value => 0);
      end if;
      Take_Buffer (Ctx, Buffer);
      pragma Warnings (Off, "unused assignment to ""Buffer""");
      RFLX.TLS_Handshake.SH_Extensions_TLS.Initialize (Seq_Ctx, Buffer, First, Last);
      pragma Warnings (On, "unused assignment to ""Buffer""");
   end Switch_To_Extensions_TLS;

   procedure Update_Extensions_TLS (Ctx : in out Context; Seq_Ctx : in out RFLX.TLS_Handshake.SH_Extensions_TLS.Context) is
      Valid_Sequence : constant Boolean := RFLX.TLS_Handshake.Server_Hello.Complete_Extensions_TLS (Ctx, Seq_Ctx);
      Buffer : RFLX_Types.Bytes_Ptr;
   begin
      RFLX.TLS_Handshake.SH_Extensions_TLS.Take_Buffer (Seq_Ctx, Buffer);
      Ctx.Buffer := Buffer;
      if Valid_Sequence then
         Ctx.Cursors (F_Extensions_TLS) := (State => S_Valid, First => Ctx.Cursors (F_Extensions_TLS).First, Last => Ctx.Cursors (F_Extensions_TLS).Last, Value => Ctx.Cursors (F_Extensions_TLS).Value);
      else
         Reset_Dependent_Fields (Ctx, F_Extensions_TLS);
         Ctx.Cursors (F_Extensions_TLS) := (others => <>);
      end if;
   end Update_Extensions_TLS;

end RFLX.TLS_Handshake.Server_Hello;
