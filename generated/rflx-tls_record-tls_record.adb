          when F_Ciphertext_Rec_Prefix =>
             Invalid (Ctx.Cursors (F_Ciphertext_Rec_CID_Present)),
          when F_Plaintext_Rec_Prefix =>
             Invalid (Ctx.Cursors (F_Plaintext_Rec_Tag)),
          when F_Ciphertext_Rec_CID_Present =>
             Invalid (Ctx.Cursors (F_Ciphertext_Rec_Seq_Size_16)),
          when F_Plaintext_Rec_Tag =>
             Invalid (Ctx.Cursors (F_Plaintext_Rec_Legacy_Record_Version)),
          when F_Ciphertext_Rec_Seq_Size_16 =>
             Invalid (Ctx.Cursors (F_Ciphertext_Rec_Length_Present)),
          when F_Plaintext_Rec_Legacy_Record_Version =>
             Invalid (Ctx.Cursors (F_Plaintext_Rec_Epoch))
             and Invalid (Ctx.Cursors (F_Plaintext_Rec_Length)),
          when F_Ciphertext_Rec_Length_Present =>
             Invalid (Ctx.Cursors (F_Ciphertext_Rec_Epoch_Low)),
          when F_Plaintext_Rec_Epoch =>
             Invalid (Ctx.Cursors (F_Plaintext_Rec_Sequence_Number)),
          when F_Ciphertext_Rec_Epoch_Low =>
             Invalid (Ctx.Cursors (F_Ciphertext_Rec_CID))
             and Invalid (Ctx.Cursors (F_Ciphertext_Rec_Sequence_Number_16))
             and Invalid (Ctx.Cursors (F_Ciphertext_Rec_Sequence_Number_8)),
          when F_Plaintext_Rec_Sequence_Number =>
             Invalid (Ctx.Cursors (F_Plaintext_Rec_Length)),
          when F_Ciphertext_Rec_CID =>
             Invalid (Ctx.Cursors (F_Ciphertext_Rec_Sequence_Number_16))
             and Invalid (Ctx.Cursors (F_Ciphertext_Rec_Sequence_Number_8)),
          when F_Plaintext_Rec_Length =>
             Invalid (Ctx.Cursors (F_Plaintext_Rec_Encrypted_Record))
             and Invalid (Ctx.Cursors (F_Plaintext_Rec_Fragment)),
          when F_Ciphertext_Rec_Sequence_Number_16 | F_Ciphertext_Rec_Sequence_Number_8 =>
             Invalid (Ctx.Cursors (F_Ciphertext_Rec_Encrypted_Record))
             and Invalid (Ctx.Cursors (F_Ciphertext_Rec_Length)),
          when F_Plaintext_Rec_Encrypted_Record | F_Plaintext_Rec_Fragment =>
             True,
          when F_Ciphertext_Rec_Length =>
             Invalid (Ctx.Cursors (F_Ciphertext_Rec_Encrypted_Record)),
          when F_Ciphertext_Rec_Encrypted_Record =>
             True);

   function Sufficient_Buffer_Length (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Buffer /= null
      and Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) < RFLX_Types.Bit_Length'Last
      and Ctx.First <= Field_First (Ctx, Fld)
      and Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1 <= Ctx.Written_Last)
   with
     Pre =>
       RFLX.TLS_Record.TLS_Record.Has_Buffer (Ctx)
       and RFLX.TLS_Record.TLS_Record.Valid_Next (Ctx, Fld);

