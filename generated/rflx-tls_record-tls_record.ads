                             (if
                                 Well_Formed (Cursors (F_Plaintext_Rec_Legacy_Record_Version))
                                 and then ((RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                                            or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                                            or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                                            or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
                                           and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Tls12_Cid))
                                           and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.ACK)))
                              then
                                 Cursors (F_Plaintext_Rec_Length).Last - Cursors (F_Plaintext_Rec_Length).First + 1 = 16
                                 and then Cursors (F_Plaintext_Rec_Length).First = Cursors (F_Plaintext_Rec_Legacy_Record_Version).Last + 1)
                             and then (if
                                          Well_Formed (Cursors (F_Plaintext_Rec_Sequence_Number))
                                          and then True
                                       then
                                          Cursors (F_Plaintext_Rec_Length).Last - Cursors (F_Plaintext_Rec_Length).First + 1 = 16
                                          and then Cursors (F_Plaintext_Rec_Length).First = Cursors (F_Plaintext_Rec_Sequence_Number).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_16))
                          then
                             (if
                                 Well_Formed (Cursors (F_Ciphertext_Rec_CID))
                                 and then To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value)
                              then
                                 Cursors (F_Ciphertext_Rec_Sequence_Number_16).Last - Cursors (F_Ciphertext_Rec_Sequence_Number_16).First + 1 = 16
                                 and then Cursors (F_Ciphertext_Rec_Sequence_Number_16).First = Cursors (F_Ciphertext_Rec_CID).Last + 1)
                             and then (if
                                          Well_Formed (Cursors (F_Ciphertext_Rec_Epoch_Low))
                                          and then (not To_Actual (Cursors (F_Ciphertext_Rec_CID_Present).Value)
                                                    and then To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value))
                                       then
                                          Cursors (F_Ciphertext_Rec_Sequence_Number_16).Last - Cursors (F_Ciphertext_Rec_Sequence_Number_16).First + 1 = 16
                                          and then Cursors (F_Ciphertext_Rec_Sequence_Number_16).First = Cursors (F_Ciphertext_Rec_Epoch_Low).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_8))
                          then
                             (if
                                 Well_Formed (Cursors (F_Ciphertext_Rec_CID))
                                 and then not To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value)
                              then
                                 Cursors (F_Ciphertext_Rec_Sequence_Number_8).Last - Cursors (F_Ciphertext_Rec_Sequence_Number_8).First + 1 = 8
                                 and then Cursors (F_Ciphertext_Rec_Sequence_Number_8).First = Cursors (F_Ciphertext_Rec_CID).Last + 1)
                             and then (if
                                          Well_Formed (Cursors (F_Ciphertext_Rec_Epoch_Low))
                                          and then (not To_Actual (Cursors (F_Ciphertext_Rec_CID_Present).Value)
                                                    and then not To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value))
                                       then
                                          Cursors (F_Ciphertext_Rec_Sequence_Number_8).Last - Cursors (F_Ciphertext_Rec_Sequence_Number_8).First + 1 = 8
                                          and then Cursors (F_Ciphertext_Rec_Sequence_Number_8).First = Cursors (F_Ciphertext_Rec_Epoch_Low).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Plaintext_Rec_Encrypted_Record))
                          then
                             (Cursors (F_Plaintext_Rec_Encrypted_Record).Last - Cursors (F_Plaintext_Rec_Encrypted_Record).First + 1 = RFLX_Types.Bit_Length (Cursors (F_Plaintext_Rec_Length).Value) * 8
                              and then Cursors (F_Plaintext_Rec_Encrypted_Record).First = Cursors (F_Plaintext_Rec_Length).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Plaintext_Rec_Fragment))
                          then
                             (Cursors (F_Plaintext_Rec_Fragment).Last - Cursors (F_Plaintext_Rec_Fragment).First + 1 = RFLX_Types.Bit_Length (Cursors (F_Plaintext_Rec_Length).Value) * 8
                              and then Cursors (F_Plaintext_Rec_Fragment).First = Cursors (F_Plaintext_Rec_Length).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Ciphertext_Rec_Length))
                          then
                             (if
                                 Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_16))
                                 and then To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value)
                              then
                                 Cursors (F_Ciphertext_Rec_Length).Last - Cursors (F_Ciphertext_Rec_Length).First + 1 = 16
                                 and then Cursors (F_Ciphertext_Rec_Length).First = Cursors (F_Ciphertext_Rec_Sequence_Number_16).Last + 1)
                             and then (if
                                          Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_8))
                                          and then To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value)
                                       then
                                          Cursors (F_Ciphertext_Rec_Length).Last - Cursors (F_Ciphertext_Rec_Length).First + 1 = 16
                                          and then Cursors (F_Ciphertext_Rec_Length).First = Cursors (F_Ciphertext_Rec_Sequence_Number_8).Last + 1))
                and then (if
                             Well_Formed (Cursors (F_Ciphertext_Rec_Encrypted_Record))
                          then
                             (if
                                 Well_Formed (Cursors (F_Ciphertext_Rec_Length))
                                 and then True
                              then
                                 Cursors (F_Ciphertext_Rec_Encrypted_Record).Last - Cursors (F_Ciphertext_Rec_Encrypted_Record).First + 1 = RFLX_Types.Bit_Length (Cursors (F_Ciphertext_Rec_Length).Value) * 8
                                 and then Cursors (F_Ciphertext_Rec_Encrypted_Record).First = Cursors (F_Ciphertext_Rec_Length).Last + 1)
                             and then (if
                                          Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_16))
                                          and then not To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value)
                                       then
                                          Cursors (F_Ciphertext_Rec_Encrypted_Record).Last - Cursors (F_Ciphertext_Rec_Encrypted_Record).First + 1 = RFLX_Types.Bit_Length (Written_Last) - RFLX_Types.Bit_Length (Cursors (F_Ciphertext_Rec_Sequence_Number_16).Last)
                                          and then Cursors (F_Ciphertext_Rec_Encrypted_Record).First = Cursors (F_Ciphertext_Rec_Sequence_Number_16).Last + 1)
                             and then (if
                                          Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_8))
                                          and then not To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value)
                                       then
                                          Cursors (F_Ciphertext_Rec_Encrypted_Record).Last - Cursors (F_Ciphertext_Rec_Encrypted_Record).First + 1 = RFLX_Types.Bit_Length (Written_Last) - RFLX_Types.Bit_Length (Cursors (F_Ciphertext_Rec_Sequence_Number_8).Last)
                                          and then Cursors (F_Ciphertext_Rec_Encrypted_Record).First = Cursors (F_Ciphertext_Rec_Sequence_Number_8).Last + 1))))
   with
     Post =>
       True;

   pragma Warnings (On, """Buffer"" is not modified, could be of access constant type");

   pragma Warnings (On, "postcondition does not mention function result");

   type Context (Buffer_First, Buffer_Last : RFLX_Types.Index := RFLX_Types.Index'First; First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First; Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First) is
      record
         Verified_Last : RFLX_Types.Bit_Length := First - 1;
         Written_Last : RFLX_Types.Bit_Length := First - 1;
         Buffer : RFLX_Types.Bytes_Ptr := null;
         Cursors : Field_Cursors := (others => <>);
      end record
   with
     Dynamic_Predicate =>
       Valid_Context (Context.Buffer_First, Context.Buffer_Last, Context.First, Context.Last, Context.Verified_Last, Context.Written_Last, Context.Buffer, Context.Cursors);

   function Initialized (Ctx : Context) return Boolean is
     (Ctx.Verified_Last = Ctx.First - 1
      and then Valid_Next (Ctx, F_Prefix)
      and then RFLX.TLS_Record.TLS_Record.Field_First (Ctx, RFLX.TLS_Record.TLS_Record.F_Prefix) rem RFLX_Types.Byte'Size = 1
      and then Available_Space (Ctx, F_Prefix) = Ctx.Last - Ctx.First + 1
      and then (for all F in Field =>
                   Invalid (Ctx, F)));

   function Read (Ctx : Context) return RFLX_Types.Bytes is
     (Ctx.Buffer.all (RFLX_Types.To_Index (Ctx.First) .. RFLX_Types.To_Index (Ctx.Verified_Last)));

   function Has_Buffer (Ctx : Context) return Boolean is
     (Ctx.Buffer /= null);

   function Buffer_Length (Ctx : Context) return RFLX_Types.Length is
     (Ctx.Buffer'Length);

   function Buffer_Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Buffer'Length * RFLX_Types.Byte'Size);

   function Size (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last - Ctx.First + 1);

   function Byte_Size (Ctx : Context) return RFLX_Types.Length is
     (RFLX_Types.To_Length (Size (Ctx)));

   function Message_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Verified_Last);

   function Written_Last (Ctx : Context) return RFLX_Types.Bit_Length is
     (Ctx.Written_Last);

   function Valid_Value (Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     (case Fld is
          when F_Prefix =>
             RFLX.TLS_Record.Valid_Prefix (Val),
          when F_Ciphertext_Rec_Prefix =>
             RFLX.TLS_Record.Valid_Ciphertext_Prefix (Val),
          when F_Plaintext_Rec_Prefix =>
             RFLX.TLS_Record.Valid_Plaintext_Prefix (Val),
          when F_Ciphertext_Rec_CID_Present =>
             Valid_Boolean (Val),
          when F_Plaintext_Rec_Tag =>
             RFLX.TLS_Record.Valid_Plaintext_Content_Type (Val),
          when F_Ciphertext_Rec_Seq_Size_16 =>
             Valid_Boolean (Val),
          when F_Plaintext_Rec_Legacy_Record_Version =>
             RFLX.TLS_Common.Valid_Protocol_Version (Val),
          when F_Ciphertext_Rec_Length_Present =>
             Valid_Boolean (Val),
          when F_Plaintext_Rec_Epoch =>
             RFLX.TLS_Record.Valid_Plaintext_Epoch (Val),
          when F_Ciphertext_Rec_Epoch_Low =>
             RFLX.TLS_Record.Valid_Epoch_Low (Val),
          when F_Plaintext_Rec_Sequence_Number =>
             RFLX.TLS_Record.Valid_Plaintext_Sequence_Number (Val),
          when F_Ciphertext_Rec_CID =>
             RFLX.TLS_Record.Valid_CID (Val),
          when F_Plaintext_Rec_Length =>
             RFLX.TLS_Record.Valid_Plaintext_Length (Val),
          when F_Ciphertext_Rec_Sequence_Number_16 =>
             RFLX.TLS_Record.Valid_Ciphertext_Sequence_Number_16 (Val),
          when F_Ciphertext_Rec_Sequence_Number_8 =>
             RFLX.TLS_Record.Valid_Ciphertext_Sequence_Number_8 (Val),
          when F_Plaintext_Rec_Encrypted_Record | F_Plaintext_Rec_Fragment =>
             True,
          when F_Ciphertext_Rec_Length =>
             RFLX.TLS_Record.Valid_Ciphertext_Length (Val),
          when F_Ciphertext_Rec_Encrypted_Record =>
             True);

   function Field_Condition (Ctx : Context; Fld : Field; Val : RFLX_Types.Base_Integer) return Boolean is
     (case Fld is
          when F_Prefix =>
             Val = 1
             or else Val = 0,
          when F_Ciphertext_Rec_Prefix | F_Plaintext_Rec_Prefix | F_Ciphertext_Rec_CID_Present | F_Plaintext_Rec_Tag | F_Ciphertext_Rec_Seq_Size_16 =>
             True,
          when F_Plaintext_Rec_Legacy_Record_Version =>
             (Val /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
              and then Val /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
              and then Val /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
              and then Val /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
             or else ((Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                       or else Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                       or else Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                       or else Val = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
                      and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Tls12_Cid))
                      and then RFLX_Types.Base_Integer (Ctx.Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.ACK))),
          when F_Ciphertext_Rec_Length_Present | F_Plaintext_Rec_Epoch =>
             True,
          when F_Ciphertext_Rec_Epoch_Low =>
             To_Actual (Ctx.Cursors (F_Ciphertext_Rec_CID_Present).Value)
             or else (not To_Actual (Ctx.Cursors (F_Ciphertext_Rec_CID_Present).Value)
                      and then To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Seq_Size_16).Value))
             or else (not To_Actual (Ctx.Cursors (F_Ciphertext_Rec_CID_Present).Value)
                      and then not To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Seq_Size_16).Value)),
          when F_Plaintext_Rec_Sequence_Number =>
             True,
          when F_Ciphertext_Rec_CID =>
             To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Seq_Size_16).Value)
             or else not To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Seq_Size_16).Value),
          when F_Plaintext_Rec_Length =>
             (RFLX_Types.Base_Integer (Ctx.Cursors (F_Plaintext_Rec_Tag).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
              and then (RFLX_Types.Base_Integer (Ctx.Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                        or else RFLX_Types.Base_Integer (Ctx.Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.DTLS_1_2))))
             or else (RFLX_Types.Base_Integer (Ctx.Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                      and then Val <= 16384),
          when F_Ciphertext_Rec_Sequence_Number_16 | F_Ciphertext_Rec_Sequence_Number_8 =>
             not To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Length_Present).Value)
             or else To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Length_Present).Value),
          when F_Plaintext_Rec_Encrypted_Record | F_Plaintext_Rec_Fragment | F_Ciphertext_Rec_Length | F_Ciphertext_Rec_Encrypted_Record =>
             True);

   function Field_Size (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_Size_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Fld));

   function Field_First (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Index is
     (Field_First_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Fld));

   function Field_Last (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Field_First (Ctx, Fld) + Field_Size (Ctx, Fld) - 1);

   function Valid_Next (Ctx : Context; Fld : Field) return Boolean is
     (Valid_Next_Internal (Ctx.Cursors, Ctx.First, Ctx.Verified_Last, Ctx.Written_Last, Fld));

   function Available_Space (Ctx : Context; Fld : Field) return RFLX_Types.Bit_Length is
     (Ctx.Last - Field_First (Ctx, Fld) + 1);

   function Sufficient_Space (Ctx : Context; Fld : Field) return Boolean is
     (Available_Space (Ctx, Fld) >= Field_Size (Ctx, Fld));

   function Present (Ctx : Context; Fld : Field) return Boolean is
     (Well_Formed (Ctx.Cursors (Fld))
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Well_Formed (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      or Ctx.Cursors (Fld).State = S_Well_Formed);

   function Valid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Valid
      and then Ctx.Cursors (Fld).First < Ctx.Cursors (Fld).Last + 1);

   function Incomplete (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Incomplete);

   function Invalid (Ctx : Context; Fld : Field) return Boolean is
     (Ctx.Cursors (Fld).State = S_Invalid
      or Ctx.Cursors (Fld).State = S_Incomplete);

   function Well_Formed_Message (Ctx : Context) return Boolean is
     (Well_Formed (Ctx, F_Ciphertext_Rec_Encrypted_Record)
      or else Well_Formed (Ctx, F_Plaintext_Rec_Encrypted_Record)
      or else Well_Formed (Ctx, F_Plaintext_Rec_Fragment));

   function Valid_Message (Ctx : Context) return Boolean is
     (Valid (Ctx, F_Ciphertext_Rec_Encrypted_Record)
      or else Valid (Ctx, F_Plaintext_Rec_Encrypted_Record)
      or else Valid (Ctx, F_Plaintext_Rec_Fragment));

   function Incomplete_Message (Ctx : Context) return Boolean is
     ((for some F in Field =>
          Incomplete (Ctx, F)));

   function Get_Prefix (Ctx : Context) return RFLX.TLS_Record.Prefix is
     (To_Actual (Ctx.Cursors (F_Prefix).Value));

   function Get_Ciphertext_Rec_Prefix (Ctx : Context) return RFLX.TLS_Record.Ciphertext_Prefix is
     (To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Prefix).Value));

   function Get_Plaintext_Rec_Prefix (Ctx : Context) return RFLX.TLS_Record.Plaintext_Prefix is
     (To_Actual (Ctx.Cursors (F_Plaintext_Rec_Prefix).Value));

   function Get_Ciphertext_Rec_CID_Present (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_Ciphertext_Rec_CID_Present).Value));

   function Get_Plaintext_Rec_Tag (Ctx : Context) return RFLX.TLS_Record.Plaintext_Content_Type is
     (To_Actual (Ctx.Cursors (F_Plaintext_Rec_Tag).Value));

   function Get_Ciphertext_Rec_Seq_Size_16 (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Seq_Size_16).Value));

   function Get_Plaintext_Rec_Legacy_Record_Version (Ctx : Context) return RFLX.TLS_Common.Protocol_Version is
     (To_Actual (Ctx.Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value));

   function Get_Ciphertext_Rec_Length_Present (Ctx : Context) return Boolean is
     (To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Length_Present).Value));

   function Get_Plaintext_Rec_Epoch (Ctx : Context) return RFLX.TLS_Record.Plaintext_Epoch is
     (To_Actual (Ctx.Cursors (F_Plaintext_Rec_Epoch).Value));

   function Get_Ciphertext_Rec_Epoch_Low (Ctx : Context) return RFLX.TLS_Record.Epoch_Low is
     (To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Epoch_Low).Value));

   function Get_Plaintext_Rec_Sequence_Number (Ctx : Context) return RFLX.TLS_Record.Plaintext_Sequence_Number is
     (To_Actual (Ctx.Cursors (F_Plaintext_Rec_Sequence_Number).Value));

   function Get_Ciphertext_Rec_CID (Ctx : Context) return RFLX.TLS_Record.CID is
     (To_Actual (Ctx.Cursors (F_Ciphertext_Rec_CID).Value));

   function Get_Plaintext_Rec_Length (Ctx : Context) return RFLX.TLS_Record.Plaintext_Length is
     (To_Actual (Ctx.Cursors (F_Plaintext_Rec_Length).Value));

   function Get_Ciphertext_Rec_Sequence_Number_16 (Ctx : Context) return RFLX.TLS_Record.Ciphertext_Sequence_Number_16 is
     (To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Sequence_Number_16).Value));

   function Get_Ciphertext_Rec_Sequence_Number_8 (Ctx : Context) return RFLX.TLS_Record.Ciphertext_Sequence_Number_8 is
     (To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Sequence_Number_8).Value));

   function Get_Ciphertext_Rec_Length (Ctx : Context) return RFLX.TLS_Record.Ciphertext_Length is
     (To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Length).Value));

   function Valid_Size (Ctx : Context; Fld : Field; Size : RFLX_Types.Bit_Length) return Boolean is
     (if
          Fld = F_Ciphertext_Rec_Encrypted_Record
          and then not To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Length_Present).Value)
       then
          Size <= Available_Space (Ctx, Fld)
       elsif
          Fld = F_Ciphertext_Rec_Encrypted_Record
          and then not To_Actual (Ctx.Cursors (F_Ciphertext_Rec_Length_Present).Value)
       then
          Size <= Available_Space (Ctx, Fld)
       else
          Size = Field_Size (Ctx, Fld))
   with
     Pre =>
       RFLX.TLS_Record.TLS_Record.Valid_Next (Ctx, Fld);

   function Valid_Length (Ctx : Context; Fld : Field; Length : RFLX_Types.Length) return Boolean is
     (Valid_Size (Ctx, Fld, RFLX_Types.To_Bit_Length (Length)));

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor is
     (Ctx.Cursors (Fld));

   function Context_Cursors (Ctx : Context) return Field_Cursors is
     (Ctx.Cursors);

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor is
     (Cursors (Fld));

end RFLX.TLS_Record.TLS_Record;
