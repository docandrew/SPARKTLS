       and then RFLX.TLS_Record.TLS_Record.Available_Space (Ctx, RFLX.TLS_Record.TLS_Record.F_Plaintext_Rec_Fragment) >= RFLX.TLS_Record.TLS_Record.Field_Size (Ctx, RFLX.TLS_Record.TLS_Record.F_Plaintext_Rec_Fragment)
       and then RFLX.TLS_Record.TLS_Record.Valid_Length (Ctx, RFLX.TLS_Record.TLS_Record.F_Plaintext_Rec_Fragment, Length)
       and then RFLX_Types.To_Length (RFLX.TLS_Record.TLS_Record.Available_Space (Ctx, RFLX.TLS_Record.TLS_Record.F_Plaintext_Rec_Fragment)) >= Length
       and then Process_Data_Pre (Length),
     Post =>
       Has_Buffer (Ctx)
       and Well_Formed (Ctx, F_Plaintext_Rec_Fragment)
       and (if Well_Formed_Message (Ctx) then Message_Last (Ctx) = Field_Last (Ctx, F_Plaintext_Rec_Fragment))
       and Invalid (Ctx, F_Ciphertext_Rec_Length)
       and Invalid (Ctx, F_Ciphertext_Rec_Encrypted_Record)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Valid_Next (Ctx, F_Plaintext_Rec_Fragment) = Valid_Next (Ctx, F_Plaintext_Rec_Fragment)'Old
       and Get_Prefix (Ctx) = Get_Prefix (Ctx)'Old
       and Get_Plaintext_Rec_Tag (Ctx) = Get_Plaintext_Rec_Tag (Ctx)'Old
       and Get_Plaintext_Rec_Legacy_Record_Version (Ctx) = Get_Plaintext_Rec_Legacy_Record_Version (Ctx)'Old
       and Get_Plaintext_Rec_Length (Ctx) = Get_Plaintext_Rec_Length (Ctx)'Old
       and Field_First (Ctx, F_Plaintext_Rec_Fragment) = Field_First (Ctx, F_Plaintext_Rec_Fragment)'Old;

   generic
      with procedure Process_Ciphertext_Rec_Encrypted_Record (Ciphertext_Rec_Encrypted_Record : out RFLX_Types.Bytes);
      with function Process_Data_Pre (Length : RFLX_Types.Length) return Boolean;
   procedure Generic_Set_Ciphertext_Rec_Encrypted_Record (Ctx : in out Context; Length : RFLX_Types.Length)
   with
     Pre =>
       not Ctx'Constrained
       and then RFLX.TLS_Record.TLS_Record.Has_Buffer (Ctx)
       and then RFLX.TLS_Record.TLS_Record.Valid_Next (Ctx, RFLX.TLS_Record.TLS_Record.F_Ciphertext_Rec_Encrypted_Record)
       and then RFLX.TLS_Record.TLS_Record.Available_Space (Ctx, RFLX.TLS_Record.TLS_Record.F_Ciphertext_Rec_Encrypted_Record) >= RFLX.TLS_Record.TLS_Record.Field_Size (Ctx, RFLX.TLS_Record.TLS_Record.F_Ciphertext_Rec_Encrypted_Record)
       and then RFLX.TLS_Record.TLS_Record.Valid_Length (Ctx, RFLX.TLS_Record.TLS_Record.F_Ciphertext_Rec_Encrypted_Record, Length)
       and then RFLX_Types.To_Length (RFLX.TLS_Record.TLS_Record.Available_Space (Ctx, RFLX.TLS_Record.TLS_Record.F_Ciphertext_Rec_Encrypted_Record)) >= Length
       and then Process_Data_Pre (Length),
     Post =>
       Has_Buffer (Ctx)
       and Well_Formed (Ctx, F_Ciphertext_Rec_Encrypted_Record)
       and (if
               Well_Formed_Message (Ctx)
            then
               Message_Last (Ctx) = Field_Last (Ctx, F_Ciphertext_Rec_Encrypted_Record))
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Valid_Next (Ctx, F_Ciphertext_Rec_Encrypted_Record) = Valid_Next (Ctx, F_Ciphertext_Rec_Encrypted_Record)'Old
       and Get_Prefix (Ctx) = Get_Prefix (Ctx)'Old
       and Get_Ciphertext_Rec_CID_Present (Ctx) = Get_Ciphertext_Rec_CID_Present (Ctx)'Old
       and Get_Ciphertext_Rec_Seq_Size_16 (Ctx) = Get_Ciphertext_Rec_Seq_Size_16 (Ctx)'Old
       and Get_Ciphertext_Rec_Length_Present (Ctx) = Get_Ciphertext_Rec_Length_Present (Ctx)'Old
       and Get_Ciphertext_Rec_Epoch_Low (Ctx) = Get_Ciphertext_Rec_Epoch_Low (Ctx)'Old
       and Field_First (Ctx, F_Ciphertext_Rec_Encrypted_Record) = Field_First (Ctx, F_Ciphertext_Rec_Encrypted_Record)'Old;

   function Context_Cursor (Ctx : Context; Fld : Field) return Field_Cursor
   with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors (Ctx : Context) return Field_Cursors
   with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

   function Context_Cursors_Index (Cursors : Field_Cursors; Fld : Field) return Field_Cursor
   with
     Annotate =>
       (GNATprove, Inline_For_Proof),
     Ghost;

private

   type Cursor_State is (S_Valid, S_Well_Formed, S_Invalid, S_Incomplete);

   type Field_Cursor is
      record
         State : Cursor_State := S_Invalid;
         First : RFLX_Types.Bit_Index := RFLX_Types.Bit_Index'First;
         Last : RFLX_Types.Bit_Length := RFLX_Types.Bit_Length'First;
         Value : RFLX_Types.Base_Integer := 0;
      end record;

   type Field_Cursors is array (Virtual_Field) of Field_Cursor;

   function Well_Formed (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid
      or Cursor.State = S_Well_Formed);

   function Valid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Valid);

   function Invalid (Cursor : Field_Cursor) return Boolean is
     (Cursor.State = S_Invalid
      or Cursor.State = S_Incomplete);

   pragma Warnings (Off, "postcondition does not mention function result");

   function Cursors_Invariant (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length) return Boolean is
     ((for all F in Field =>
          (if
              Well_Formed (Cursors (F))
           then
              Cursors (F).First >= First
              and Cursors (F).Last <= Verified_Last
              and Cursors (F).First <= Cursors (F).Last + 1
              and Valid_Value (F, Cursors (F).Value))))
   with
     Post =>
       True;

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (Off, "formal parameter ""*"" is not referenced");

   pragma Warnings (Off, "postcondition does not mention function result");

   pragma Warnings (Off, "unused variable ""*""");

   function Valid_Predecessors_Invariant (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length) return Boolean is
     ((if Well_Formed (Cursors (F_Prefix)) then True)
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_Prefix))
                then
                   (Valid (Cursors (F_Prefix))
                    and then Cursors (F_Prefix).Value = 1))
      and then (if
                   Well_Formed (Cursors (F_Plaintext_Rec_Prefix))
                then
                   (Valid (Cursors (F_Prefix))
                    and then Cursors (F_Prefix).Value = 0))
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_CID_Present))
                then
                   Valid (Cursors (F_Ciphertext_Rec_Prefix)))
      and then (if Well_Formed (Cursors (F_Plaintext_Rec_Tag)) then Valid (Cursors (F_Plaintext_Rec_Prefix)))
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_Seq_Size_16))
                then
                   Valid (Cursors (F_Ciphertext_Rec_CID_Present)))
      and then (if
                   Well_Formed (Cursors (F_Plaintext_Rec_Legacy_Record_Version))
                then
                   Valid (Cursors (F_Plaintext_Rec_Tag)))
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_Length_Present))
                then
                   Valid (Cursors (F_Ciphertext_Rec_Seq_Size_16)))
      and then (if
                   Well_Formed (Cursors (F_Plaintext_Rec_Epoch))
                then
                   (Valid (Cursors (F_Plaintext_Rec_Legacy_Record_Version))
                    and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                    and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                    and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                    and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1))))
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_Epoch_Low))
                then
                   Valid (Cursors (F_Ciphertext_Rec_Length_Present)))
      and then (if
                   Well_Formed (Cursors (F_Plaintext_Rec_Sequence_Number))
                then
                   Valid (Cursors (F_Plaintext_Rec_Epoch)))
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_CID))
                then
                   (Valid (Cursors (F_Ciphertext_Rec_Epoch_Low))
                    and then To_Actual (Cursors (F_Ciphertext_Rec_CID_Present).Value)))
      and then (if
                   Well_Formed (Cursors (F_Plaintext_Rec_Length))
                then
                   (Valid (Cursors (F_Plaintext_Rec_Legacy_Record_Version))
                    and then (RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                              or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                              or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                              or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
                    and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Tls12_Cid))
                    and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.ACK)))
                   or Valid (Cursors (F_Plaintext_Rec_Sequence_Number)))
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_16))
                then
                   (Valid (Cursors (F_Ciphertext_Rec_CID))
                    and then To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value))
                   or (Valid (Cursors (F_Ciphertext_Rec_Epoch_Low))
                       and then not To_Actual (Cursors (F_Ciphertext_Rec_CID_Present).Value)
                       and then To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value)))
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_8))
                then
                   (Valid (Cursors (F_Ciphertext_Rec_CID))
                    and then not To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value))
                   or (Valid (Cursors (F_Ciphertext_Rec_Epoch_Low))
                       and then not To_Actual (Cursors (F_Ciphertext_Rec_CID_Present).Value)
                       and then not To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value)))
      and then (if
                   Well_Formed (Cursors (F_Plaintext_Rec_Encrypted_Record))
                then
                   (Valid (Cursors (F_Plaintext_Rec_Length))
                    and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                    and then (RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                              or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.DTLS_1_2)))))
      and then (if
                   Well_Formed (Cursors (F_Plaintext_Rec_Fragment))
                then
                   (Valid (Cursors (F_Plaintext_Rec_Length))
                    and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                    and then Cursors (F_Plaintext_Rec_Length).Value <= 16384))
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_Length))
                then
                   (Valid (Cursors (F_Ciphertext_Rec_Sequence_Number_16))
                    and then To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value))
                   or (Valid (Cursors (F_Ciphertext_Rec_Sequence_Number_8))
                       and then To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value)))
      and then (if
                   Well_Formed (Cursors (F_Ciphertext_Rec_Encrypted_Record))
                then
                   Valid (Cursors (F_Ciphertext_Rec_Length))
                   or (Valid (Cursors (F_Ciphertext_Rec_Sequence_Number_16))
                       and then not To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value))
                   or (Valid (Cursors (F_Ciphertext_Rec_Sequence_Number_8))
                       and then not To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value))))
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last),
     Post =>
       True;

   pragma Warnings (On, "unused variable ""*""");

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (On, "formal parameter ""*"" is not referenced");

   pragma Warnings (Off, "postcondition does not mention function result");

   function Valid_Next_Internal (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Fld : Field) return Boolean is
     (case Fld is
          when F_Prefix =>
             True,
          when F_Ciphertext_Rec_Prefix =>
             (Valid (Cursors (F_Prefix))
              and then Cursors (F_Prefix).Value = 1),
          when F_Plaintext_Rec_Prefix =>
             (Valid (Cursors (F_Prefix))
              and then Cursors (F_Prefix).Value = 0),
          when F_Ciphertext_Rec_CID_Present =>
             (Valid (Cursors (F_Ciphertext_Rec_Prefix))
              and then True),
          when F_Plaintext_Rec_Tag =>
             (Valid (Cursors (F_Plaintext_Rec_Prefix))
              and then True),
          when F_Ciphertext_Rec_Seq_Size_16 =>
             (Valid (Cursors (F_Ciphertext_Rec_CID_Present))
              and then True),
          when F_Plaintext_Rec_Legacy_Record_Version =>
             (Valid (Cursors (F_Plaintext_Rec_Tag))
              and then True),
          when F_Ciphertext_Rec_Length_Present =>
             (Valid (Cursors (F_Ciphertext_Rec_Seq_Size_16))
              and then True),
          when F_Plaintext_Rec_Epoch =>
             (Valid (Cursors (F_Plaintext_Rec_Legacy_Record_Version))
              and then (RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                        and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                        and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                        and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))),
          when F_Ciphertext_Rec_Epoch_Low =>
             (Valid (Cursors (F_Ciphertext_Rec_Length_Present))
              and then True),
          when F_Plaintext_Rec_Sequence_Number =>
             (Valid (Cursors (F_Plaintext_Rec_Epoch))
              and then True),
          when F_Ciphertext_Rec_CID =>
             (Valid (Cursors (F_Ciphertext_Rec_Epoch_Low))
              and then To_Actual (Cursors (F_Ciphertext_Rec_CID_Present).Value)),
          when F_Plaintext_Rec_Length =>
             (Valid (Cursors (F_Plaintext_Rec_Legacy_Record_Version))
              and then ((RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_3))
                         or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                         or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_0))
                         or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_1)))
                        and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Tls12_Cid))
                        and then RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.ACK))))
             or (Valid (Cursors (F_Plaintext_Rec_Sequence_Number))
                 and then True),
          when F_Ciphertext_Rec_Sequence_Number_16 =>
             (Valid (Cursors (F_Ciphertext_Rec_CID))
              and then To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value))
             or (Valid (Cursors (F_Ciphertext_Rec_Epoch_Low))
                 and then (not To_Actual (Cursors (F_Ciphertext_Rec_CID_Present).Value)
                           and then To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value))),
          when F_Ciphertext_Rec_Sequence_Number_8 =>
             (Valid (Cursors (F_Ciphertext_Rec_CID))
              and then not To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value))
             or (Valid (Cursors (F_Ciphertext_Rec_Epoch_Low))
                 and then (not To_Actual (Cursors (F_Ciphertext_Rec_CID_Present).Value)
                           and then not To_Actual (Cursors (F_Ciphertext_Rec_Seq_Size_16).Value))),
          when F_Plaintext_Rec_Encrypted_Record =>
             (Valid (Cursors (F_Plaintext_Rec_Length))
              and then (RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                        and then (RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.TLS_1_2))
                                  or else RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Legacy_Record_Version).Value) = RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Common.DTLS_1_2))))),
          when F_Plaintext_Rec_Fragment =>
             (Valid (Cursors (F_Plaintext_Rec_Length))
              and then (RFLX_Types.Base_Integer (Cursors (F_Plaintext_Rec_Tag).Value) /= RFLX_Types.Base_Integer (To_Base_Integer (RFLX.TLS_Record.Application_Data))
                        and then Cursors (F_Plaintext_Rec_Length).Value <= 16384)),
          when F_Ciphertext_Rec_Length =>
             (Valid (Cursors (F_Ciphertext_Rec_Sequence_Number_16))
              and then To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value))
             or (Valid (Cursors (F_Ciphertext_Rec_Sequence_Number_8))
                 and then To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value)),
          when F_Ciphertext_Rec_Encrypted_Record =>
             (Valid (Cursors (F_Ciphertext_Rec_Length))
              and then True)
             or (Valid (Cursors (F_Ciphertext_Rec_Sequence_Number_16))
                 and then not To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value))
             or (Valid (Cursors (F_Ciphertext_Rec_Sequence_Number_8))
                 and then not To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value)))
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last),
     Post =>
       True;

   pragma Warnings (On, "postcondition does not mention function result");

   pragma Warnings (Off, "unused variable ""*""");

   pragma Warnings (Off, "formal parameter ""*"" is not referenced");

   function Field_Size_Internal (Cursors : Field_Cursors; First : RFLX_Types.Bit_Index; Verified_Last : RFLX_Types.Bit_Length; Written_Last : RFLX_Types.Bit_Length; Fld : Field) return RFLX_Types.Bit_Length'Base is
     (case Fld is
          when F_Prefix | F_Ciphertext_Rec_Prefix | F_Plaintext_Rec_Prefix =>
             3,
          when F_Ciphertext_Rec_CID_Present =>
             1,
          when F_Plaintext_Rec_Tag =>
             5,
          when F_Ciphertext_Rec_Seq_Size_16 =>
             1,
          when F_Plaintext_Rec_Legacy_Record_Version =>
             16,
          when F_Ciphertext_Rec_Length_Present =>
             1,
          when F_Plaintext_Rec_Epoch =>
             16,
          when F_Ciphertext_Rec_Epoch_Low =>
             2,
          when F_Plaintext_Rec_Sequence_Number =>
             48,
          when F_Ciphertext_Rec_CID =>
             8,
          when F_Plaintext_Rec_Length | F_Ciphertext_Rec_Sequence_Number_16 =>
             16,
          when F_Ciphertext_Rec_Sequence_Number_8 =>
             8,
          when F_Plaintext_Rec_Encrypted_Record | F_Plaintext_Rec_Fragment =>
             RFLX_Types.Bit_Length (Cursors (F_Plaintext_Rec_Length).Value) * 8,
          when F_Ciphertext_Rec_Length =>
             16,
          when F_Ciphertext_Rec_Encrypted_Record =>
             (if
                 Well_Formed (Cursors (F_Ciphertext_Rec_Length))
              then
                 RFLX_Types.Bit_Length (Cursors (F_Ciphertext_Rec_Length).Value) * 8
              elsif
                 Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_16))
                 and then not To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value)
              then
                 RFLX_Types.Bit_Length (Written_Last) - RFLX_Types.Bit_Length (Cursors (F_Ciphertext_Rec_Sequence_Number_16).Last)
              elsif
                 Well_Formed (Cursors (F_Ciphertext_Rec_Sequence_Number_8))
                 and then not To_Actual (Cursors (F_Ciphertext_Rec_Length_Present).Value)
              then
                 RFLX_Types.Bit_Length (Written_Last) - RFLX_Types.Bit_Length (Cursors (F_Ciphertext_Rec_Sequence_Number_8).Last)
              else
                 RFLX_Types.Unreachable))
   with
     Pre =>
       Cursors_Invariant (Cursors, First, Verified_Last)
       and then Valid_Predecessors_Invariant (Cursors, First, Verified_Last, Written_Last)
       and then Valid_Next_Internal (Cursors, First, Verified_Last, Written_Last, Fld);

   pragma Warnings (On, "formal parameter ""*"" is not referenced");

   pragma Warnings (On, "unused variable ""*""");

