       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Available_Space (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Named_Curve) >= RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Field_Size (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Named_Curve)
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Field_Condition (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Named_Curve, RFLX.Tls_Parameters.To_Base_Integer (Val)),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, F_Named_Curve)
       and Get_Named_Curve (Ctx) = Val
       and Invalid (Ctx, F_Point_Length)
       and Invalid (Ctx, F_Point)
       and Invalid (Ctx, F_Algorithm)
       and Invalid (Ctx, F_Signature_Length)
       and Invalid (Ctx, F_Signature)
       and Valid_Next (Ctx, F_Point_Length)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Valid_Next (Ctx, F_Named_Curve) = Valid_Next (Ctx, F_Named_Curve)'Old
       and Get_Curve_Type (Ctx) = Get_Curve_Type (Ctx)'Old
       and Field_First (Ctx, F_Named_Curve) = Field_First (Ctx, F_Named_Curve)'Old
       and (for all F in Field range F_Curve_Type .. F_Curve_Type =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F))
   is
   begin
      Set_Scalar (Ctx, F_Named_Curve, RFLX.Tls_Parameters.To_Base_Integer (Val));
   end Set_Named_Curve;

   procedure Set_Algorithm (Ctx : in out Context; Val : RFLX.Tls_Parameters.TLS_SignatureScheme)
   with
     Pre =>
       not Ctx'Constrained
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Has_Buffer (Ctx)
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Valid_Next (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Algorithm)
       and then RFLX.Tls_Parameters.Valid_TLS_SignatureScheme (Val)
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Available_Space (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Algorithm) >= RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Field_Size (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Algorithm)
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Field_Condition (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Algorithm, RFLX.Tls_Parameters.To_Base_Integer (Val)),
     Post =>
       Has_Buffer (Ctx)
       and Valid (Ctx, F_Algorithm)
       and Get_Algorithm (Ctx) = Val
       and Invalid (Ctx, F_Signature_Length)
       and Invalid (Ctx, F_Signature)
       and Valid_Next (Ctx, F_Signature_Length)
       and Ctx.Buffer_First = Ctx.Buffer_First'Old
       and Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and Ctx.First = Ctx.First'Old
       and Ctx.Last = Ctx.Last'Old
       and Valid_Next (Ctx, F_Algorithm) = Valid_Next (Ctx, F_Algorithm)'Old
       and Get_Curve_Type (Ctx) = Get_Curve_Type (Ctx)'Old
       and Get_Named_Curve (Ctx) = Get_Named_Curve (Ctx)'Old
       and Get_Point_Length (Ctx) = Get_Point_Length (Ctx)'Old
       and Field_First (Ctx, F_Algorithm) = Field_First (Ctx, F_Algorithm)'Old
       and (for all F in Field range F_Curve_Type .. F_Point =>
               Context_Cursors_Index (Context_Cursors (Ctx), F) = Context_Cursors_Index (Context_Cursors (Ctx)'Old, F))
   is
   begin
      Set_Scalar (Ctx, F_Algorithm, RFLX.Tls_Parameters.To_Base_Integer (Val));
   end Set_Algorithm;

   procedure Set_Signature_Empty (Ctx : in out Context) is
      Unused_Buffer_First, Unused_Buffer_Last : RFLX_Types.Index;
      Unused_Offset : RFLX_Types.Offset;
   begin
      Set (Ctx, F_Signature, 0, 0, True, Unused_Buffer_First, Unused_Buffer_Last, Unused_Offset);
   end Set_Signature_Empty;

   procedure Initialize_Point_Private (Ctx : in out Context; Length : RFLX_Types.Length)
   with
     Pre =>
       not Ctx'Constrained
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Has_Buffer (Ctx)
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Valid_Next (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Point)
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Valid_Length (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Point, Length)
       and then RFLX_Types.To_Length (RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Available_Space (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Point)) >= Length,
     Post =>
       Has_Buffer (Ctx)
       and then Well_Formed (Ctx, F_Point)
       and then Field_Size (Ctx, F_Point) = RFLX_Types.To_Bit_Length (Length)
       and then Ctx.Verified_Last = Field_Last (Ctx, F_Point)
       and then Invalid (Ctx, F_Algorithm)
       and then Invalid (Ctx, F_Signature_Length)
       and then Invalid (Ctx, F_Signature)
       and then Valid_Next (Ctx, F_Algorithm)
       and then Ctx.Buffer_First = Ctx.Buffer_First'Old
       and then Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and then Ctx.First = Ctx.First'Old
       and then Ctx.Last = Ctx.Last'Old
       and then Valid_Next (Ctx, F_Point) = Valid_Next (Ctx, F_Point)'Old
       and then Get_Curve_Type (Ctx) = Get_Curve_Type (Ctx)'Old
       and then Get_Named_Curve (Ctx) = Get_Named_Curve (Ctx)'Old
       and then Get_Point_Length (Ctx) = Get_Point_Length (Ctx)'Old
       and then Field_First (Ctx, F_Point) = Field_First (Ctx, F_Point)'Old
   is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Point);
      Last : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Point) + RFLX_Types.Bit_Length (Length) * RFLX_Types.Byte'Size - 1;
   begin
      pragma Assert (Last mod RFLX_Types.Byte'Size = 0);
      Reset_Dependent_Fields (Ctx, F_Point);
      pragma Warnings (Off, "attribute Update is an obsolescent feature");
      Ctx := Ctx'Update (Verified_Last => Last, Written_Last => Last);
      pragma Warnings (On, "attribute Update is an obsolescent feature");
      Ctx.Cursors (F_Point) := (State => S_Well_Formed, First => First, Last => Last, Value => 0);
   end Initialize_Point_Private;

   procedure Initialize_Point (Ctx : in out Context) is
   begin
      Initialize_Point_Private (Ctx, RFLX_Types.To_Length (Field_Size (Ctx, F_Point)));
   end Initialize_Point;

   procedure Initialize_Signature_Private (Ctx : in out Context; Length : RFLX_Types.Length)
   with
     Pre =>
       not Ctx'Constrained
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Has_Buffer (Ctx)
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Valid_Next (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Signature)
       and then RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Valid_Length (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Signature, Length)
       and then RFLX_Types.To_Length (RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Available_Space (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Signature)) >= Length,
     Post =>
       Has_Buffer (Ctx)
       and then Well_Formed (Ctx, F_Signature)
       and then Field_Size (Ctx, F_Signature) = RFLX_Types.To_Bit_Length (Length)
       and then Ctx.Verified_Last = Field_Last (Ctx, F_Signature)
       and then Ctx.Buffer_First = Ctx.Buffer_First'Old
       and then Ctx.Buffer_Last = Ctx.Buffer_Last'Old
       and then Ctx.First = Ctx.First'Old
       and then Ctx.Last = Ctx.Last'Old
       and then Valid_Next (Ctx, F_Signature) = Valid_Next (Ctx, F_Signature)'Old
       and then Get_Curve_Type (Ctx) = Get_Curve_Type (Ctx)'Old
       and then Get_Named_Curve (Ctx) = Get_Named_Curve (Ctx)'Old
       and then Get_Point_Length (Ctx) = Get_Point_Length (Ctx)'Old
       and then Get_Algorithm (Ctx) = Get_Algorithm (Ctx)'Old
       and then Get_Signature_Length (Ctx) = Get_Signature_Length (Ctx)'Old
       and then Field_First (Ctx, F_Signature) = Field_First (Ctx, F_Signature)'Old
   is
      First : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Signature);
      Last : constant RFLX_Types.Bit_Index := Field_First (Ctx, F_Signature) + RFLX_Types.Bit_Length (Length) * RFLX_Types.Byte'Size - 1;
   begin
      pragma Assert (Last mod RFLX_Types.Byte'Size = 0);
      Reset_Dependent_Fields (Ctx, F_Signature);
      pragma Warnings (Off, "attribute Update is an obsolescent feature");
      Ctx := Ctx'Update (Verified_Last => Last, Written_Last => Last);
      pragma Warnings (On, "attribute Update is an obsolescent feature");
      Ctx.Cursors (F_Signature) := (State => S_Well_Formed, First => First, Last => Last, Value => 0);
   end Initialize_Signature_Private;

   procedure Initialize_Signature (Ctx : in out Context) is
   begin
      Initialize_Signature_Private (Ctx, RFLX_Types.To_Length (Field_Size (Ctx, F_Signature)));
   end Initialize_Signature;

   procedure Set_Point (Ctx : in out Context; Data : RFLX_Types.Bytes) is
      Buffer_First : constant RFLX_Types.Index := RFLX_Types.To_Index (Field_First (Ctx, F_Point));
      Buffer_Last : constant RFLX_Types.Index := Buffer_First + Data'Length - 1;
   begin
      Initialize_Point_Private (Ctx, Data'Length);
      pragma Assert (Buffer_Last = RFLX_Types.To_Index (Field_Last (Ctx, F_Point)));
      Ctx.Buffer.all (Buffer_First .. Buffer_Last) := Data;
      pragma Assert (Ctx.Buffer.all (RFLX_Types.To_Index (Field_First (Ctx, F_Point)) .. RFLX_Types.To_Index (Field_Last (Ctx, F_Point))) = Data);
   end Set_Point;

   procedure Set_Signature (Ctx : in out Context; Data : RFLX_Types.Bytes) is
      Buffer_First : constant RFLX_Types.Index := RFLX_Types.To_Index (Field_First (Ctx, F_Signature));
      Buffer_Last : constant RFLX_Types.Index := Buffer_First + Data'Length - 1;
   begin
      Initialize_Signature_Private (Ctx, Data'Length);
      pragma Assert (Buffer_Last = RFLX_Types.To_Index (Field_Last (Ctx, F_Signature)));
      Ctx.Buffer.all (Buffer_First .. Buffer_Last) := Data;
      pragma Assert (Ctx.Buffer.all (RFLX_Types.To_Index (Field_First (Ctx, F_Signature)) .. RFLX_Types.To_Index (Field_Last (Ctx, F_Signature))) = Data);
   end Set_Signature;

   procedure Generic_Set_Point (Ctx : in out Context; Length : RFLX_Types.Length) is
      First : constant RFLX_Types.Index := RFLX_Types.To_Index (Field_First (Ctx, F_Point));
   begin
      if Length > 0 then
         Process_Point (Ctx.Buffer.all (First .. First + RFLX_Types.Index (Length) - 1));
      end if;
      pragma Assert (RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Valid_Length (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Point, Length));
      Initialize_Point_Private (Ctx, Length);
   end Generic_Set_Point;

   procedure Generic_Set_Signature (Ctx : in out Context; Length : RFLX_Types.Length) is
      First : constant RFLX_Types.Index := RFLX_Types.To_Index (Field_First (Ctx, F_Signature));
   begin
      if Length > 0 then
         Process_Signature (Ctx.Buffer.all (First .. First + RFLX_Types.Index (Length) - 1));
      end if;
      pragma Assert (RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.Valid_Length (Ctx, RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE.F_Signature, Length));
      Initialize_Signature_Private (Ctx, Length);
   end Generic_Set_Signature;

   procedure To_Structure (Ctx : Context; Struct : out Structure) is
   begin
      Struct.Curve_Type := Get_Curve_Type (Ctx);
      Struct.Named_Curve := Get_Named_Curve (Ctx);
      Struct.Point_Length := Get_Point_Length (Ctx);
      Struct.Point := (others => 0);
      Get_Point (Ctx, Struct.Point (Struct.Point'First .. Struct.Point'First + RFLX_Types.Index (RFLX_Types.To_Length (Field_Size (Ctx, F_Point)) + 1) - 2));
      Struct.Algorithm := Get_Algorithm (Ctx);
      Struct.Signature_Length := Get_Signature_Length (Ctx);
      Struct.Signature := (others => 0);
      Get_Signature (Ctx, Struct.Signature (Struct.Signature'First .. Struct.Signature'First + RFLX_Types.Index (RFLX_Types.To_Length (Field_Size (Ctx, F_Signature)) + 1) - 2));
   end To_Structure;

   procedure To_Context (Struct : Structure; Ctx : in out Context) is
   begin
      Reset (Ctx);
      Set_Curve_Type (Ctx, Struct.Curve_Type);
      Set_Named_Curve (Ctx, Struct.Named_Curve);
      Set_Point_Length (Ctx, Struct.Point_Length);
      Set_Point (Ctx, Struct.Point (Struct.Point'First .. Struct.Point'First + RFLX_Types.Index (RFLX_Types.To_Length (RFLX_Types.Bit_Length (Struct.Point_Length) * 8) + 1) - 2));
      Set_Algorithm (Ctx, Struct.Algorithm);
      Set_Signature_Length (Ctx, Struct.Signature_Length);
      Set_Signature (Ctx, Struct.Signature (Struct.Signature'First .. Struct.Signature'First + RFLX_Types.Index (RFLX_Types.To_Length (RFLX_Types.Bit_Length (Struct.Signature_Length) * 8) + 1) - 2));
   end To_Context;

end RFLX.TLS_Handshake.TLS_1_2_Server_Key_Exchange_ECDHE;
