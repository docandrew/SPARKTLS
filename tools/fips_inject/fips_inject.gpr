--  Post-link step for the FIPS 140-3 software integrity test. Not part of
--  the library; applications run it once on their linked executable.
with "sparktlscrypto.gpr";

project FIPS_Inject is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "../../bin/tools";
   for Create_Missing_Dirs use "True";
   for Main use ("fips_inject.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-O2", "-gnata", "-gnato");
   end Compiler;
end FIPS_Inject;
