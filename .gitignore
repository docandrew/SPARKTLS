obj/
lib/
bin/
alire/
config/
*.txt
#  The BoGo failure baseline is the one .txt that MUST be tracked: run.sh
#  diffs against it to detect regressions, and without it CI silently falls
#  back to "no baseline" and stops detecting them at all.
!tests/bogo/EXPECTED_FAILURES.txt

# Generated on demand by tests/Makefile for manual openssl s_server
# sessions. Not used by any automated suite -- those use tests/certs/.
tests/tlscipher.lan.crt
tests/tlscipher.lan.csr
tests/tlscipher.lan.key

# Generated by tests/tlsanvil/run.sh; never tracked, and excluded from
