with "../sparktls.gpr";
with "../../sparkentropy/sparkentropy.gpr";

project SPARKTLS_Examples is

   for Source_Dirs use (".");
   for Object_Dir use "../bin/examples";
   for Create_Missing_Dirs use "True";
   for Main use ("tls_fetch.adb", "tls_web_epoll.adb",
                  "tls_test_client.adb", "tls_test_server.adb",
                  "tls_blocking_server.adb",
                  "tls_bench_server.adb",
                  "tls_sni_server.adb",
                  "mtls_test_client.adb",
                  "tls_resume_test.adb",
                  "tls12_resume_test.adb",
                  "test_prf12.adb");

   package Compiler is
      --  -gnat2022: sparktls.ads has a postcondition on an
      --  access-to-subprogram type, so consumers must parse it too.
      for Default_Switches ("Ada") use
        ("-gnat2022",
         "-O3", "-gnatn", "-march=native", "-mtune=native",
         "-g", "-gnatQ", "-gnatw.X");
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es");
   end Binder;
end SPARKTLS_Examples;
